module Editing exposing (editingSuite)

{-| Changing a file and leaving the rest of it alone.

This is the suite for the thing the package exists to do. Every test here reads
a file, changes one thing, writes it back, and compares the *whole file* against
what it should now be -- not the value that changed, the file. That is the only
comparison that can catch the failure mode this package is about, which is not
"the edit was wrong" but "everything else moved".

The file below is deliberately awkward: aligned equals signs, a tab indent, a
comment block that belongs to a key, a comment block that belongs to nobody
because of the blank line above it, a hex integer, a trailing comment, and no
final newline.

@docs editingSuite

-}

import Array exposing (Array)
import Basics exposing (..)
import BigInt
import Bytes
import Expect
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import Task
import Test.Runner.UnitNode as U
import Toml
import Toml.Ast as Ast
import Toml.Edit as Edit
import Toml.Encode as Encode
import Toml.Table as Table


{-| The file under test, as lines. Written this way so the whitespace in it is
visible and deliberate rather than a consequence of the indentation here.
-}
before : Array String
before =
    [ "# A config file with opinions about whitespace."
    , ""
    , "name    = \"widget\"        # what it is called"
    , "retries = 3"
    , ""
    , "# How long to wait before giving up."
    , "# Seconds, not milliseconds."
    , "timeout = 30"
    , ""
    , "# This block explains the section below, and has a blank line above it,"
    , "# so it belongs to nobody and must survive anything done to [server]."
    , ""
    , "[server]"
    , "\thost = \"example.com\""
    , "\tport = 0x1F"
    , ""
    , "[server.tls]"
    , "enabled = true"
    , ""
    , "[logging]"
    , "level = \"warn\""
    ]


source : String
source =
    String.join "\n" before


{-| Read, change, write. The whole file comes back as a single string.
-}
edit : (Toml.Document -> Toml.Document) -> Result String String
edit change =
    Toml.parse source
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


{-| The file with `before` changed by an ordinary line-level edit, so that a
test can say what it expects by describing the change rather than by repeating
twenty lines.
-}
expecting : (Array String -> Array String) -> Result String String
expecting change =
    Ok (String.join "\n" (change before))


replaceLine : String -> String -> Array String -> Array String
replaceLine old new lines =
    Array.map
        (\line ->
            if line == old then
                new

            else
                line
        )
        lines


dropLines : Array String -> Array String -> Array String
dropLines gone lines =
    Array.keepIf (\line -> not (Array.member line gone)) lines


afterLine : String -> String -> Array String -> Array String
afterLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ line, added ]

            else
                [ line ]
        )
        lines


{-| The fixture without the line that follows `anchor`, which is how a test
says "the blank line above this block went away" without repeating the file.
-}
withoutLineAfter : String -> Array String -> Array String
withoutLineAfter anchor lines =
    Array.indexedMap
        (\index line ->
            if Array.get (index - 1) lines == Just anchor && index > 0 then
                Nothing

            else
                Just line
        )
        lines
        |> Array.mapAndKeepJust identity


beforeLine : String -> String -> Array String -> Array String
beforeLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ added, line ]

            else
                [ line ]
        )
        lines


{-| The same read-change-write as `edit`, for the few tests whose point needs a
file the fixture above does not have -- a dotted key, mostly.
-}
editing : String -> (Toml.Document -> Toml.Document) -> Result String String
editing text change =
    Toml.parse text
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


intValue : Table.Value -> Maybe Int
intValue found =
    when found is
        Table.IntegerValue whole ->
            BigInt.toInt whole

        _ ->
            Nothing


{-| -}
editingSuite : U.Suite
editingSuite =
    U.suite
        { name = "Editing"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            -- THE FILE COMES BACK
            [ U.test "an untouched document is the file it came from" <| \_ ->
                Task.succeed (Expect.equal (Ok source) (edit identity))
            -- CHANGING A VALUE CHANGES ONLY THE VALUE
            , U.test "changing a value keeps the alignment around it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 5"))
                        (edit (Edit.set [ "retries" ] (Edit.int 5)))
                    )
            , U.test "and the trailing comment on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"gadget\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "gadget")))
                    )
            , U.test "a key inside a table is found through its header" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tport = 9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090)))
                    )
            , U.test "and one two levels down" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "enabled = true" "enabled = false"))
                        (edit (Edit.set [ "server", "tls", "enabled" ] (Edit.bool False)))
                    )
            , U.test "a string is escaped on the way in" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"a\\tb\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "a\tb")))
                    )
            -- ADDING A KEY
            , U.test "a new key lands with the others in its table, indented to match" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "\tport = 0x1F" "\tretries = 2"))
                        (edit (Edit.set [ "server", "retries" ] (Edit.int 2)))
                    )
            , U.test "a new top-level key lands after the last top-level key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "verbose = true"))
                        (edit (Edit.set [ "verbose" ] (Edit.bool True)))
                    )
            , U.test "a key for a table that does not exist brings a header with it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok (source ++ "\n\n[metrics]\nenabled = true"))
                        (edit (Edit.set [ "metrics", "enabled" ] (Edit.bool True)))
                    )
            , U.test "appending to a file that ends with a newline leaves it ending with one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2\n")
                        (editing "a = 1\n" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "and one that does not, still not" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2")
                        (editing "a = 1" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a section appended to an empty file gets no blank line above it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[b]\nc = 2\n")
                        (editing "" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a top-level key in a file with none yet goes before the first header, not inside the last table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n[a]\nx = 1\n")
                        (editing "[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and above the comment block that belongs to that header" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n# about a\n[a]\nx = 1\n")
                        (editing "# about a\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "but below a comment the blank line under it gave to the document" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "# title\n\ny = 2\n\n[a]\nx = 1\n")
                        (editing "# title\n\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and it really is top-level: the table tree agrees" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just 2))
                        (Toml.parse "# about a\n[a]\nx = 1"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.set [ "y" ] (Edit.int 2))
                            |> Result.andThen (Table.fromDocument >> Result.mapError Table.errorToString)
                            |> Result.map (Table.get "y" >> Maybe.andThen intValue)
                        )
                    )
            -- ARRAYS OF TABLES
            , U.test "a path into an array of tables names its last item, as TOML does" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "x" ] (Edit.int 9)))
                    )
            , U.test "and a new key goes into that same item" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 2\ny = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "y" ] (Edit.int 9)))
                    )
            , U.test "so get reads what set would change" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "2"))
                        (Toml.parse "[[p]]\nx = 1\n\n[[p]]\nx = 2\n"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.get [ "p", "x" ] >> Maybe.map rawOf)
                        )
                    )
            -- REMOVING A KEY, AND ITS COMMENTS
            , U.test "removing a key takes the comment block above it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines
                                [ "# How long to wait before giving up."
                                , "# Seconds, not milliseconds."
                                , "timeout = 30"
                                ]
                            )
                        )
                        (edit (Edit.remove [ "timeout" ]))
                    )
            , U.test "and the trailing comment on its own line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "name    = \"widget\"        # what it is called" ]))
                        (edit (Edit.remove [ "name" ]))
                    )
            , U.test "a key with no comment above it takes nothing extra" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "retries = 3" ]))
                        (edit (Edit.remove [ "retries" ]))
                    )
            , U.test "removing a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.remove [ "nope" ])))
            -- THE BLANK LINE IS THE ESCAPE HATCH
            , U.test "a comment block with a blank line above it survives" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 12 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server" ]))
                    )
            -- A SECTION'S OWN BLANK LINES GO WITH IT
            , U.test "removing a table takes the whitespace inside it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 16 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server", "tls" ]))
                    )
            -- LOOKING AROUND
            , U.test "comments says which ones belong to a key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { blankBefore = True
                        , leading =
                            [ " How long to wait before giving up."
                            , " Seconds, not milliseconds."
                            ]
                        , trailing = Nothing
                        }
                        (readComments [ "timeout" ])
                    )
            , U.test "and which one is on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { blankBefore = True, leading = [], trailing = Just " what it is called" }
                        (readComments [ "name" ])
                    )
            , U.test "paths lists every key, headers resolved" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            [ [ "name" ]
                            , [ "retries" ]
                            , [ "timeout" ]
                            , [ "server", "host" ]
                            , [ "server", "port" ]
                            , [ "server", "tls", "enabled" ]
                            , [ "logging", "level" ]
                            ]
                        )
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map Edit.paths
                        )
                    )
            -- EDITS COMPOSE
            , U.test "several edits in a row are still only those edits" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "retries = 3" "retries = 5"
                                >> replaceLine "\tport = 0x1F" "\tport = 8443"
                                >> dropLines [ "level = \"warn\"" ]
                                >> afterLine "\tport = 8443" "\tbacklog = 128"
                            )
                        )
                        (edit
                            (Edit.set [ "retries" ] (Edit.int 5)
                                >> Edit.set [ "server", "port" ] (Edit.int 8443)
                                >> Edit.remove [ "logging", "level" ]
                                >> Edit.set [ "server", "backlog" ] (Edit.int 128)
                            )
                        )
                    )
            -- SETTING A COMPOSITE VALUE
            , U.test "an array is written on one line, with a space after each comma" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "ports = [80, 443]"))
                        (edit (Edit.set [ "ports" ] (Edit.array [ Edit.int 80, Edit.int 443 ])))
                    )
            , U.test "an inline table too, indented to match its neighbours" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "\tport = 0x1F"
                                "\tlimits = { soft = 1024, hard = 4096 }"
                            )
                        )
                        (edit
                            (Edit.set [ "server", "limits" ]
                                (Edit.inlineTable
                                    [ { key = "soft", value = Edit.int 1024 }
                                    , { key = "hard", value = Edit.int 4096 }
                                    ]
                                )
                            )
                        )
                    )
            , U.test "an empty one of each has no space inside it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30" "ports = []"
                                >> afterLine "ports = []" "limits = {}"
                            )
                        )
                        (edit
                            (Edit.set [ "ports" ] (Edit.array [])
                                >> Edit.set [ "limits" ] (Edit.inlineTable [])
                            )
                        )
                    )
            , U.test "and they nest, which is the only way into an inline table" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30"
                                "peers = [{ name = \"alpha\" }, { name = \"beta\" }]"
                            )
                        )
                        (edit
                            (Edit.set [ "peers" ]
                                (Edit.array
                                    [ Edit.inlineTable [ { key = "name", value = Edit.string "alpha" } ]
                                    , Edit.inlineTable [ { key = "name", value = Edit.string "beta" } ]
                                    ]
                                )
                            )
                        )
                    )
            -- SETTING WHAT IS ALREADY THERE
            --
            -- The property that makes "write the whole configuration back" a
            -- safe thing for a program to do on every save. Each of these sets
            -- a value the file already has, spelled differently, and the file
            -- has to come back byte for byte -- including the spelling, which
            -- is the part a caller would lose.
            , U.test "setting a value to what it already is changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.set [ "retries" ] (Edit.int 3)))
                    )
            , U.test "and the file keeps its own spelling of the number" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.set [ "server", "port" ] (Edit.int 0x1F)))
                    )
            , U.test "an array set to the same elements keeps the lines it was written on" <| \_ ->
                let
                    text =
                        "zones = [\n  \"Asia/Seoul\",     # them\n  \"America/Chicago\" # me\n]\n"
                in
                Task.succeed
                    (Expect.equal (Ok text)
                        (editing text
                            (Edit.set [ "zones" ]
                                (Edit.array
                                    [ Edit.string "Asia/Seoul", Edit.string "America/Chicago" ]
                                )
                            )
                        )
                    )
            , U.test "but reordering it is a change, and is written as one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "zones = [\"America/Chicago\", \"Asia/Seoul\"]\n")
                        (editing "zones = [\n  \"Asia/Seoul\",\n  \"America/Chicago\"\n]\n"
                            (Edit.set [ "zones" ]
                                (Edit.array
                                    [ Edit.string "America/Chicago", Edit.string "Asia/Seoul" ]
                                )
                            )
                        )
                    )
            , U.test "1.50 and 1.5 are the same number, so the file keeps 1.50" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "ratio = 1.50\n")
                        (editing "ratio = 1.50\n" (Edit.set [ "ratio" ] (Edit.float 1.5)))
                    )
            , U.test "and a different number is written" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "ratio = 1.6\n")
                        (editing "ratio = 1.50\n" (Edit.set [ "ratio" ] (Edit.float 1.6)))
                    )
            , U.test "a literal string and a basic one with the same characters are equal" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "name = 'widget'\n")
                        (editing "name = 'widget'\n" (Edit.set [ "name" ] (Edit.string "widget")))
                    )
            , U.test "an inline table with its entries in another order is a change" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "limits = { hard = 4096, soft = 1024 }\n")
                        (editing "limits = { soft = 1024, hard = 4096 }\n"
                            (Edit.set [ "limits" ]
                                (Edit.inlineTable
                                    [ { key = "hard", value = Edit.int 4096 }
                                    , { key = "soft", value = Edit.int 1024 }
                                    ]
                                )
                            )
                        )
                    )
            , U.test "a value of another type is a change even when it reads the same" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "n = \"1\"\n")
                        (editing "n = 1\n" (Edit.set [ "n" ] (Edit.string "1")))
                    )
            -- IS IT THERE
            , U.test "member says whether a key is in the file" <| \_ ->
                Task.succeed
                    (Expect.equal { there = True, absent = False }
                        (when Toml.parse source is
                            Ok document ->
                                { there = Edit.member [ "server", "port" ] document
                                , absent = Edit.member [ "server", "nope" ] document
                                }

                            Err _ ->
                                { there = False, absent = True }
                        )
                    )
            -- WRITING COMMENTS
            , U.test "a comment added to a line that had none gets a space in front of it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 3 # why so few"))
                        (edit
                            (Edit.setComments [ "retries" ]
                                { blankBefore = False, leading = [], trailing = Just " why so few" }
                            )
                        )
                    )
            , U.test "and one replacing another keeps the alignment that was there" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\"        # renamed"
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { blankBefore = True, leading = [], trailing = Just " renamed" }
                            )
                        )
                    )
            , U.test "taking one off takes the whitespace before it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\""
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "a leading block replaces the one that was above the key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines [ "# Seconds, not milliseconds." ]
                                >> replaceLine
                                    "# How long to wait before giving up."
                                    "# Seconds. Not milliseconds."
                            )
                        )
                        (edit
                            (Edit.setComments [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds. Not milliseconds." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "and a new block is indented to match the key it explains" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\tport = 0x1F" "\t# The one to listen on."))
                        (edit
                            (Edit.setComments [ "server", "port" ]
                                { blankBefore = False
                                , leading = [ " The one to listen on." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "the floating block above [server] is not the key's to replace" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\thost = \"example.com\"" "\t# The host."))
                        (edit
                            (Edit.setComments [ "server", "host" ]
                                { blankBefore = False
                                , leading = [ " The host." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "reading the comments and writing them back changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setComments path (Edit.comments path document) soFar
                                    )
                                    document
                                    (Edit.paths document)
                            )
                        )
                    )
            -- A HEADER'S OWN COMMENTS
            , U.test "tableComments reads the block over a header, and a floating one is not it" <| \_ ->
                -- The block above [server] has a blank line under it, so it is
                -- nobody's; all the header owns is the blank.
                Task.succeed
                    (Expect.equal
                        (Ok { blankBefore = True, leading = [], trailing = Nothing })
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.tableComments [ "server" ])
                        )
                    )
            , U.test "setTableComments explains a section" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (beforeLine "[server.tls]" "# Encryption."
                                >> replaceLine "[server.tls]" "[server.tls] # off by default"
                            )
                        )
                        (edit
                            (Edit.setTableComments [ "server", "tls" ]
                                { blankBefore = True
                                , leading = [ " Encryption." ]
                                , trailing = Just " off by default"
                                }
                            )
                        )
                    )
            , U.test "reading a header's comments and writing them back changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setTableComments path (Edit.tableComments path document) soFar
                                    )
                                    document
                                    [ [ "server" ], [ "server", "tls" ], [ "logging" ] ]
                            )
                        )
                    )
            , U.test "for an array of tables it is the first header, where Encode puts them" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "# Everyone we talk to.\n[[peer]]\nn = 1\n\n[[peer]]\nn = 2\n")
                        (editing "[[peer]]\nn = 1\n\n[[peer]]\nn = 2\n"
                            (Edit.setTableComments [ "peer" ]
                                { blankBefore = True
                                , leading = [ " Everyone we talk to." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "a table with no header line has nothing to read and nothing to write on" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { read = { blankBefore = False, leading = [], trailing = Nothing }
                        , written = Ok "a.b = 1\n"
                        }
                        { read =
                            Toml.parse "a.b = 1\n"
                                |> Result.map (Edit.tableComments [ "a" ])
                                |> Result.withDefault { blankBefore = True, leading = [ "?" ], trailing = Nothing }
                        , written =
                            editing "a.b = 1\n"
                                (Edit.setTableComments [ "a" ]
                                    { blankBefore = False, leading = [ " nope" ], trailing = Nothing }
                                )
                        }
                    )
            , U.test "a nested header directly under its parent may have its blank line, unlike a key" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[a]\n\n[a.b]\n")
                        (editing "[a]\n[a.b]\n"
                            (Edit.setTableComments [ "a", "b" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            -- THE BLANK LINE ABOVE A COMMENT BLOCK
            , U.test "the first key of a file has no blank line above it" <| \_ ->
                -- Array.get -1 is the last element in Gren, and the last
                -- expression of a file that ends with a newline is blank.
                Task.succeed
                    (Expect.equal (Ok False)
                        (Toml.parse "a = 1\n"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (\document -> (Edit.comments [ "a" ] document).blankBefore)
                        )
                    )
            , U.test "blankBefore puts an empty line above the block" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "retries = 3" ""))
                        (edit
                            (Edit.setComments [ "retries" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "and False takes one away" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (withoutLineAfter "# A config file with opinions about whitespace."
                                >> withoutLineAfter "retries = 3"
                            )
                        )
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setComments path
                                            { blankBefore = False
                                            , leading = (Edit.comments path document).leading
                                            , trailing = (Edit.comments path document).trailing
                                            }
                                            soFar
                                    )
                                    document
                                    (Edit.paths document)
                            )
                        )
                    )
            , U.test "asking for one at the top of the file does nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n")
                        (editing "a = 1\n"
                            (Edit.setComments [ "a" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "nor directly under a header, where the key belongs against it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[server]\n# The one to listen on.\nport = 1\n")
                        (editing "[server]\nport = 1\n"
                            (Edit.setComments [ "server", "port" ]
                                { blankBefore = True
                                , leading = [ " The one to listen on." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            -- INTRODUCE
            , U.test "introduce explains a key it is the one to invent" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n# Seconds.\ntimeout = 30\n")
                        (editing "a = 1\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 30)
                            )
                        )
                    )
            , U.test "and says nothing about one that was already there" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "timeout = 45\n")
                        (editing "timeout = 30\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 45)
                            )
                        )
                    )
            , U.test "not even when the explanation it would have written is gone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "timeout = 30\n")
                        (editing "timeout = 30\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 30)
                            )
                        )
                    )
            -- THE FILE THAT IS NOT THERE YET
            , U.test "an empty document writes as nothing at all" <| \_ ->
                Task.succeed (Expect.equal "" (Toml.toString Toml.empty))
            , U.test "and creating a file is the same code as changing one" <| \_ ->
                let
                    write document =
                        document
                            |> Edit.introduce
                                [ "theme" ]
                                { blankBefore = True
                                , leading = [ " Which scheme to open in." ]
                                , trailing = Nothing
                                }
                                (Edit.string "dark")
                            |> Edit.introduce
                                [ "zones" ]
                                { blankBefore = True
                                , leading = [ " In the order they are shown." ]
                                , trailing = Nothing
                                }
                                (Edit.array [ Edit.string "Asia/Seoul" ])
                in
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                [ "# Which scheme to open in."
                                , "theme = \"dark\""
                                , ""
                                , "# In the order they are shown."
                                , "zones = [\"Asia/Seoul\"]"
                                , ""
                                ]
                            )
                        )
                        (Ok (Toml.toString (write Toml.empty)))
                    )
            , U.test "and the second run over that file changes only what moved" <| \_ ->
                let
                    once =
                        Toml.toString
                            (Edit.introduce [ "theme" ]
                                { blankBefore = True, leading = [ " Scheme." ], trailing = Nothing }
                                (Edit.string "dark")
                                Toml.empty
                            )
                in
                Task.succeed
                    (Expect.equal (Ok "# Scheme.\ntheme = \"gren\"\n")
                        (editing once
                            (Edit.introduce [ "theme" ]
                                { blankBefore = True, leading = [ " Scheme." ], trailing = Nothing }
                                (Edit.string "gren")
                            )
                        )
                    )
            , U.test "a key that brings its own header is not held off it by its blank line" <| \_ ->
                -- The first run of a config program is exactly this: every
                -- key asks for a blank above its explanation, and the first
                -- key of each new table would otherwise land under an empty
                -- line -- `[server]`, blank, comment, key.
                let
                    explained text =
                        { blankBefore = True, leading = [ text ], trailing = Nothing }
                in
                Task.succeed
                    (Expect.equal
                        (String.join "\n"
                            [ "# Scheme."
                            , "theme = \"dark\""
                            , ""
                            , "[server]"
                            , "# Port."
                            , "port = 1"
                            , ""
                            , "# Host."
                            , "host = \"h\""
                            , ""
                            ]
                        )
                        (Toml.empty
                            |> Edit.introduce [ "theme" ] (explained " Scheme.") (Edit.string "dark")
                            |> Edit.introduce [ "server", "port" ] (explained " Port.") (Edit.int 1)
                            |> Edit.introduce [ "server", "host" ] (explained " Host.") (Edit.string "h")
                            |> Toml.toString
                        )
                    )
            , U.test "and the file it writes is the file Encode writes for the same shape" <| \_ ->
                -- The two modules decide their blank lines in different
                -- places -- `tidyBlanks` there, `spacedTo` here -- and this is
                -- what keeps them deciding the same thing.
                let
                    explained text =
                        { blankBefore = True, leading = [ text ], trailing = Nothing }

                    edited =
                        Toml.empty
                            |> Edit.introduce [ "theme" ] (explained " Scheme.") (Edit.string "dark")
                            |> Edit.introduce [ "server", "port" ] (explained " Port.") (Edit.int 1)
                            |> Edit.introduce [ "server", "host" ] (explained " Host.") (Edit.string "h")
                            |> Edit.setTableComments [ "server" ] (explained " Where to reach it.")
                            |> Toml.toString

                    encoded =
                        Encode.toString
                            [ Encode.field "theme" (Encode.string "dark")
                                |> Encode.commented { leading = [ " Scheme." ], trailing = Nothing }
                            , Encode.field "server"
                                (Encode.table
                                    [ Encode.field "port" (Encode.int 1)
                                        |> Encode.commented { leading = [ " Port." ], trailing = Nothing }
                                    , Encode.field "host" (Encode.string "h")
                                        |> Encode.commented { leading = [ " Host." ], trailing = Nothing }
                                    ]
                                )
                                |> Encode.commented { leading = [ " Where to reach it." ], trailing = Nothing }
                            ]
                in
                Task.succeed (Expect.equal encoded edited)
            , U.test "an empty file parses to Toml.empty, so first run and empty file are one case" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok Toml.empty)
                        (Toml.parse "" |> Result.mapError Toml.errorToString)
                    )
            -- RENAMING
            , U.test "renaming a key changes the name and nothing else on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tlisten = 0x1F"))
                        (edit (Edit.rename [ "server", "port" ] "listen"))
                    )
            , U.test "a name the grammar will not take bare is quoted" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "\"max retries\" = 3"))
                        (edit (Edit.rename [ "retries" ] "max retries"))
                    )
            , U.test "renaming a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.rename [ "nope" ] "x")))
            , U.test "renaming a table takes its headers and the ones nested under it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "[server]" "[listener]"
                                >> replaceLine "[server.tls]" "[listener.tls]"
                            )
                        )
                        (edit (Edit.renameTable [ "server" ] "listener"))
                    )
            , U.test "and a comment that talks about [server] is still a comment" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok True)
                        (edit (Edit.renameTable [ "server" ] "listener")
                            |> Result.map
                                (String.contains
                                    "must survive anything done to [server]"
                                )
                        )
                    )
            , U.test "only the last part of the path is the new name" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "[server.tls]" "[server.secure]"))
                        (edit (Edit.renameTable [ "server", "tls" ] "secure"))
                    )
            , U.test "renameTable will not rename a key, since a key is not a table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.renameTable [ "server", "port" ] "listen"))
                    )
            , U.test "a table a dotted key wrote is renamed where the key spells it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "x.b = 1\nx.c = 2\nb = 3")
                        (editing "a.b = 1\na.c = 2\nb = 3"
                            (Edit.renameTable [ "a" ] "x")
                        )
                    )
            , U.test "and the last part of a dotted key is the value, so it is left alone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a.b = 1")
                        (editing "a.b = 1" (Edit.renameTable [ "a", "b" ] "z"))
                    )
            -- THE BYTES BACK
            , U.test "toBytes is the file the document came from" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just source))
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.toString)
                        )
                    )
            , U.test "and it carries a byte order mark back, which a String cannot say" <| \_ ->
                let
                    original =
                        Bytes.fromString ("\u{FEFF}" ++ source)
                in
                Task.succeed
                    (Expect.equal (Ok (Bytes.length original))
                        (Toml.parseBytes original
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.length)
                        )
                    )
            , U.test "unless the String still has the mark, which parse then keeps too" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok ("\u{FEFF}" ++ source))
                        (Toml.parse ("\u{FEFF}" ++ source)
                            |> Result.mapError Toml.errorToString
                            |> Result.map Toml.toString
                        )
                    )
            -- AND THE RESULT IS STILL A TOML FILE
            , U.test "what comes out parses again to what was asked for" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090))
                            |> Result.andThen
                                (\written ->
                                    Toml.parse written
                                        |> Result.mapError Toml.errorToString
                                        |> Result.map
                                            (\document ->
                                                Edit.get [ "server", "port" ] document
                                                    |> Maybe.map rawOf
                                            )
                                )
                        )
                    )
            ]
        }


readComments : Array String -> Edit.Comments
readComments path =
    when Toml.parse source is
        Ok document ->
            Edit.comments path document

        Err _ ->
            { blankBefore = False, leading = [], trailing = Nothing }


rawOf : Ast.Value -> String
rawOf content =
    when content is
        Ast.IntegerVal fields ->
            fields.raw

        _ ->
            "?"
