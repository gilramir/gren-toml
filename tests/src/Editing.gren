module Editing exposing (editingSuite)

{-| Changing a file and leaving the rest of it alone.

This is the suite for the thing the package exists to do. Every test here reads
a file, changes one thing, writes it back, and compares the *whole file* against
what it should now be -- not the value that changed, the file. That is the only
comparison that can catch the failure mode this package is about, which is not
"the edit was wrong" but "everything else moved".

The file below is deliberately awkward: aligned equals signs, a tab indent, a
comment block that belongs to a key, a comment block that belongs to nobody
because of the blank line above it, a hex integer, a trailing comment, and no
final newline.

@docs editingSuite

-}

import Array exposing (Array)
import Basics exposing (..)
import BigInt
import Bytes
import Expect
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import Task
import Test.Runner.UnitNode as U
import Toml
import Toml.Ast as Ast
import Toml.Edit as Edit
import Toml.Table as Table


{-| The file under test, as lines. Written this way so the whitespace in it is
visible and deliberate rather than a consequence of the indentation here.
-}
before : Array String
before =
    [ "# A config file with opinions about whitespace."
    , ""
    , "name    = \"widget\"        # what it is called"
    , "retries = 3"
    , ""
    , "# How long to wait before giving up."
    , "# Seconds, not milliseconds."
    , "timeout = 30"
    , ""
    , "# This block explains the section below, and has a blank line above it,"
    , "# so it belongs to nobody and must survive anything done to [server]."
    , ""
    , "[server]"
    , "\thost = \"example.com\""
    , "\tport = 0x1F"
    , ""
    , "[server.tls]"
    , "enabled = true"
    , ""
    , "[logging]"
    , "level = \"warn\""
    ]


source : String
source =
    String.join "\n" before


{-| Read, change, write. The whole file comes back as a single string.
-}
edit : (Toml.Document -> Toml.Document) -> Result String String
edit change =
    Toml.parse source
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


{-| The file with `before` changed by an ordinary line-level edit, so that a
test can say what it expects by describing the change rather than by repeating
twenty lines.
-}
expecting : (Array String -> Array String) -> Result String String
expecting change =
    Ok (String.join "\n" (change before))


replaceLine : String -> String -> Array String -> Array String
replaceLine old new lines =
    Array.map
        (\line ->
            if line == old then
                new

            else
                line
        )
        lines


dropLines : Array String -> Array String -> Array String
dropLines gone lines =
    Array.keepIf (\line -> not (Array.member line gone)) lines


afterLine : String -> String -> Array String -> Array String
afterLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ line, added ]

            else
                [ line ]
        )
        lines


beforeLine : String -> String -> Array String -> Array String
beforeLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ added, line ]

            else
                [ line ]
        )
        lines


{-| The same read-change-write as `edit`, for the few tests whose point needs a
file the fixture above does not have -- a dotted key, mostly.
-}
editing : String -> (Toml.Document -> Toml.Document) -> Result String String
editing text change =
    Toml.parse text
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


intValue : Table.Value -> Maybe Int
intValue found =
    when found is
        Table.IntegerValue whole ->
            BigInt.toInt whole

        _ ->
            Nothing


{-| -}
editingSuite : U.Suite
editingSuite =
    U.suite
        { name = "Editing"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            -- THE FILE COMES BACK
            [ U.test "an untouched document is the file it came from" <| \_ ->
                Task.succeed (Expect.equal (Ok source) (edit identity))
            -- CHANGING A VALUE CHANGES ONLY THE VALUE
            , U.test "changing a value keeps the alignment around it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 5"))
                        (edit (Edit.set [ "retries" ] (Edit.int 5)))
                    )
            , U.test "and the trailing comment on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"gadget\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "gadget")))
                    )
            , U.test "a key inside a table is found through its header" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tport = 9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090)))
                    )
            , U.test "and one two levels down" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "enabled = true" "enabled = false"))
                        (edit (Edit.set [ "server", "tls", "enabled" ] (Edit.bool False)))
                    )
            , U.test "a string is escaped on the way in" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"a\\tb\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "a\tb")))
                    )
            -- ADDING A KEY
            , U.test "a new key lands with the others in its table, indented to match" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "\tport = 0x1F" "\tretries = 2"))
                        (edit (Edit.set [ "server", "retries" ] (Edit.int 2)))
                    )
            , U.test "a new top-level key lands after the last top-level key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "verbose = true"))
                        (edit (Edit.set [ "verbose" ] (Edit.bool True)))
                    )
            , U.test "a key for a table that does not exist brings a header with it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok (source ++ "\n\n[metrics]\nenabled = true"))
                        (edit (Edit.set [ "metrics", "enabled" ] (Edit.bool True)))
                    )
            , U.test "appending to a file that ends with a newline leaves it ending with one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2\n")
                        (editing "a = 1\n" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "and one that does not, still not" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2")
                        (editing "a = 1" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a section appended to an empty file gets no blank line above it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[b]\nc = 2\n")
                        (editing "" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a top-level key in a file with none yet goes before the first header, not inside the last table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n[a]\nx = 1\n")
                        (editing "[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and above the comment block that belongs to that header" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n# about a\n[a]\nx = 1\n")
                        (editing "# about a\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "but below a comment the blank line under it gave to the document" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "# title\n\ny = 2\n\n[a]\nx = 1\n")
                        (editing "# title\n\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and it really is top-level: the table tree agrees" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just 2))
                        (Toml.parse "# about a\n[a]\nx = 1"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.set [ "y" ] (Edit.int 2))
                            |> Result.andThen (Table.fromDocument >> Result.mapError Table.errorToString)
                            |> Result.map (Table.get "y" >> Maybe.andThen intValue)
                        )
                    )
            -- ARRAYS OF TABLES
            , U.test "a path into an array of tables names its last item, as TOML does" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "x" ] (Edit.int 9)))
                    )
            , U.test "and a new key goes into that same item" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 2\ny = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "y" ] (Edit.int 9)))
                    )
            , U.test "so get reads what set would change" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "2"))
                        (Toml.parse "[[p]]\nx = 1\n\n[[p]]\nx = 2\n"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.get [ "p", "x" ] >> Maybe.map rawOf)
                        )
                    )
            -- REMOVING A KEY, AND ITS COMMENTS
            , U.test "removing a key takes the comment block above it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines
                                [ "# How long to wait before giving up."
                                , "# Seconds, not milliseconds."
                                , "timeout = 30"
                                ]
                            )
                        )
                        (edit (Edit.remove [ "timeout" ]))
                    )
            , U.test "and the trailing comment on its own line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "name    = \"widget\"        # what it is called" ]))
                        (edit (Edit.remove [ "name" ]))
                    )
            , U.test "a key with no comment above it takes nothing extra" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "retries = 3" ]))
                        (edit (Edit.remove [ "retries" ]))
                    )
            , U.test "removing a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.remove [ "nope" ])))
            -- THE BLANK LINE IS THE ESCAPE HATCH
            , U.test "a comment block with a blank line above it survives" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 12 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server" ]))
                    )
            -- A SECTION'S OWN BLANK LINES GO WITH IT
            , U.test "removing a table takes the whitespace inside it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 16 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server", "tls" ]))
                    )
            -- LOOKING AROUND
            , U.test "comments says which ones belong to a key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { leading =
                            [ " How long to wait before giving up."
                            , " Seconds, not milliseconds."
                            ]
                        , trailing = Nothing
                        }
                        (readComments [ "timeout" ])
                    )
            , U.test "and which one is on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { leading = [], trailing = Just " what it is called" }
                        (readComments [ "name" ])
                    )
            , U.test "paths lists every key, headers resolved" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            [ [ "name" ]
                            , [ "retries" ]
                            , [ "timeout" ]
                            , [ "server", "host" ]
                            , [ "server", "port" ]
                            , [ "server", "tls", "enabled" ]
                            , [ "logging", "level" ]
                            ]
                        )
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map Edit.paths
                        )
                    )
            -- EDITS COMPOSE
            , U.test "several edits in a row are still only those edits" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "retries = 3" "retries = 5"
                                >> replaceLine "\tport = 0x1F" "\tport = 8443"
                                >> dropLines [ "level = \"warn\"" ]
                                >> afterLine "\tport = 8443" "\tbacklog = 128"
                            )
                        )
                        (edit
                            (Edit.set [ "retries" ] (Edit.int 5)
                                >> Edit.set [ "server", "port" ] (Edit.int 8443)
                                >> Edit.remove [ "logging", "level" ]
                                >> Edit.set [ "server", "backlog" ] (Edit.int 128)
                            )
                        )
                    )
            -- SETTING A COMPOSITE VALUE
            , U.test "an array is written on one line, with a space after each comma" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "ports = [80, 443]"))
                        (edit (Edit.set [ "ports" ] (Edit.array [ Edit.int 80, Edit.int 443 ])))
                    )
            , U.test "an inline table too, indented to match its neighbours" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "\tport = 0x1F"
                                "\tlimits = { soft = 1024, hard = 4096 }"
                            )
                        )
                        (edit
                            (Edit.set [ "server", "limits" ]
                                (Edit.inlineTable
                                    [ { key = "soft", value = Edit.int 1024 }
                                    , { key = "hard", value = Edit.int 4096 }
                                    ]
                                )
                            )
                        )
                    )
            , U.test "an empty one of each has no space inside it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30" "ports = []"
                                >> afterLine "ports = []" "limits = {}"
                            )
                        )
                        (edit
                            (Edit.set [ "ports" ] (Edit.array [])
                                >> Edit.set [ "limits" ] (Edit.inlineTable [])
                            )
                        )
                    )
            , U.test "and they nest, which is the only way into an inline table" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30"
                                "peers = [{ name = \"alpha\" }, { name = \"beta\" }]"
                            )
                        )
                        (edit
                            (Edit.set [ "peers" ]
                                (Edit.array
                                    [ Edit.inlineTable [ { key = "name", value = Edit.string "alpha" } ]
                                    , Edit.inlineTable [ { key = "name", value = Edit.string "beta" } ]
                                    ]
                                )
                            )
                        )
                    )
            -- WRITING COMMENTS
            , U.test "a comment added to a line that had none gets a space in front of it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 3 # why so few"))
                        (edit
                            (Edit.setComments [ "retries" ]
                                { leading = [], trailing = Just " why so few" }
                            )
                        )
                    )
            , U.test "and one replacing another keeps the alignment that was there" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\"        # renamed"
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { leading = [], trailing = Just " renamed" }
                            )
                        )
                    )
            , U.test "taking one off takes the whitespace before it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\""
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "a leading block replaces the one that was above the key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines [ "# Seconds, not milliseconds." ]
                                >> replaceLine
                                    "# How long to wait before giving up."
                                    "# Seconds. Not milliseconds."
                            )
                        )
                        (edit
                            (Edit.setComments [ "timeout" ]
                                { leading = [ " Seconds. Not milliseconds." ], trailing = Nothing }
                            )
                        )
                    )
            , U.test "and a new block is indented to match the key it explains" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\tport = 0x1F" "\t# The one to listen on."))
                        (edit
                            (Edit.setComments [ "server", "port" ]
                                { leading = [ " The one to listen on." ], trailing = Nothing }
                            )
                        )
                    )
            , U.test "the floating block above [server] is not the key's to replace" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\thost = \"example.com\"" "\t# The host."))
                        (edit
                            (Edit.setComments [ "server", "host" ]
                                { leading = [ " The host." ], trailing = Nothing }
                            )
                        )
                    )
            , U.test "reading the comments and writing them back changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setComments path (Edit.comments path document) soFar
                                    )
                                    document
                                    (Edit.paths document)
                            )
                        )
                    )
            -- RENAMING
            , U.test "renaming a key changes the name and nothing else on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tlisten = 0x1F"))
                        (edit (Edit.rename [ "server", "port" ] "listen"))
                    )
            , U.test "a name the grammar will not take bare is quoted" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "\"max retries\" = 3"))
                        (edit (Edit.rename [ "retries" ] "max retries"))
                    )
            , U.test "renaming a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.rename [ "nope" ] "x")))
            , U.test "renaming a table takes its headers and the ones nested under it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "[server]" "[listener]"
                                >> replaceLine "[server.tls]" "[listener.tls]"
                            )
                        )
                        (edit (Edit.renameTable [ "server" ] "listener"))
                    )
            , U.test "and a comment that talks about [server] is still a comment" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok True)
                        (edit (Edit.renameTable [ "server" ] "listener")
                            |> Result.map
                                (String.contains
                                    "must survive anything done to [server]"
                                )
                        )
                    )
            , U.test "only the last part of the path is the new name" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "[server.tls]" "[server.secure]"))
                        (edit (Edit.renameTable [ "server", "tls" ] "secure"))
                    )
            , U.test "renameTable will not rename a key, since a key is not a table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.renameTable [ "server", "port" ] "listen"))
                    )
            , U.test "a table a dotted key wrote is renamed where the key spells it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "x.b = 1\nx.c = 2\nb = 3")
                        (editing "a.b = 1\na.c = 2\nb = 3"
                            (Edit.renameTable [ "a" ] "x")
                        )
                    )
            , U.test "and the last part of a dotted key is the value, so it is left alone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a.b = 1")
                        (editing "a.b = 1" (Edit.renameTable [ "a", "b" ] "z"))
                    )
            -- THE BYTES BACK
            , U.test "toBytes is the file the document came from" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just source))
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.toString)
                        )
                    )
            , U.test "and it carries a byte order mark back, which a String cannot say" <| \_ ->
                let
                    original =
                        Bytes.fromString ("﻿" ++ source)
                in
                Task.succeed
                    (Expect.equal (Ok (Bytes.length original))
                        (Toml.parseBytes original
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.length)
                        )
                    )
            , U.test "unless the String still has the mark, which parse then keeps too" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok ("﻿" ++ source))
                        (Toml.parse ("﻿" ++ source)
                            |> Result.mapError Toml.errorToString
                            |> Result.map Toml.toString
                        )
                    )
            -- AND THE RESULT IS STILL A TOML FILE
            , U.test "what comes out parses again to what was asked for" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090))
                            |> Result.andThen
                                (\written ->
                                    Toml.parse written
                                        |> Result.mapError Toml.errorToString
                                        |> Result.map
                                            (\document ->
                                                Edit.get [ "server", "port" ] document
                                                    |> Maybe.map rawOf
                                            )
                                )
                        )
                    )
            ]
        }


readComments : Array String -> { leading : Array String, trailing : Maybe String }
readComments path =
    when Toml.parse source is
        Ok document ->
            Edit.comments path document

        Err _ ->
            { leading = [], trailing = Nothing }


rawOf : Ast.Value -> String
rawOf content =
    when content is
        Ast.IntegerVal fields ->
            fields.raw

        _ ->
            "?"
