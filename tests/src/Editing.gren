module Editing exposing (editingSuite)

{-| Changing a file and leaving the rest of it alone.

This is the suite for the thing the package exists to do. Every test here reads
a file, changes one thing, writes it back, and compares the *whole file* against
what it should now be -- not the value that changed, the file. That is the only
comparison that can catch the failure mode this package is about, which is not
"the edit was wrong" but "everything else moved".

The file below is deliberately awkward: aligned equals signs, a tab indent, a
comment block that belongs to a key, a comment block that belongs to nobody
because of the blank line above it, a hex integer, a trailing comment, and no
final newline.

@docs editingSuite

-}

import Array exposing (Array)
import Basics exposing (..)
import BigInt
import Bytes
import Expect
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import Task
import Test.Runner.UnitNode as U
import Toml
import Toml.Ast as Ast
import Toml.Decode as Decode
import Toml.Edit as Edit
import Toml.Encode as Encode
import Toml.Table as Table


{-| The file under test, as lines. Written this way so the whitespace in it is
visible and deliberate rather than a consequence of the indentation here.
-}
before : Array String
before =
    [ "# A config file with opinions about whitespace."
    , ""
    , "name    = \"widget\"        # what it is called"
    , "retries = 3"
    , ""
    , "# How long to wait before giving up."
    , "# Seconds, not milliseconds."
    , "timeout = 30"
    , ""
    , "# This block explains the section below, and has a blank line above it,"
    , "# so it belongs to nobody and must survive anything done to [server]."
    , ""
    , "[server]"
    , "\thost = \"example.com\""
    , "\tport = 0x1F"
    , ""
    , "[server.tls]"
    , "enabled = true"
    , ""
    , "[logging]"
    , "level = \"warn\""
    ]


source : String
source =
    String.join "\n" before


{-| Read, change, write. The whole file comes back as a single string.
-}
edit : (Toml.Document -> Toml.Document) -> Result String String
edit change =
    Toml.parse source
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


{-| The file with `before` changed by an ordinary line-level edit, so that a
test can say what it expects by describing the change rather than by repeating
twenty lines.
-}
expecting : (Array String -> Array String) -> Result String String
expecting change =
    Ok (String.join "\n" (change before))


replaceLine : String -> String -> Array String -> Array String
replaceLine old new lines =
    Array.map
        (\line ->
            if line == old then
                new

            else
                line
        )
        lines


dropLines : Array String -> Array String -> Array String
dropLines gone lines =
    Array.keepIf (\line -> not (Array.member line gone)) lines


afterLine : String -> String -> Array String -> Array String
afterLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ line, added ]

            else
                [ line ]
        )
        lines


{-| The fixture without the line that follows `anchor`, which is how a test
says "the blank line above this block went away" without repeating the file.
-}
withoutLineAfter : String -> Array String -> Array String
withoutLineAfter anchor lines =
    Array.indexedMap
        (\index line ->
            if Array.get (index - 1) lines == Just anchor && index > 0 then
                Nothing

            else
                Just line
        )
        lines
        |> Array.mapAndKeepJust identity


{-| The fixture with two of its lines exchanged, which is what a move looks
like from outside the file.
-}
swapLines : String -> String -> Array String -> Array String
swapLines one other lines =
    Array.map
        (\line ->
            if line == one then
                other

            else if line == other then
                one

            else
                line
        )
        lines


beforeLine : String -> String -> Array String -> Array String
beforeLine anchor added lines =
    Array.mapAndFlatten
        (\line ->
            if line == anchor then
                [ added, line ]

            else
                [ line ]
        )
        lines


{-| The same read-change-write as `edit`, for the few tests whose point needs a
file the fixture above does not have -- a dotted key, mostly.
-}
editing : String -> (Toml.Document -> Toml.Document) -> Result String String
editing text change =
    Toml.parse text
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


{-| Write a key with an explanation above it, then take it out again: the two
calls a program makes when a setting is turned on and then put back to its
default. It has to be the identity on the file, however many times it is run.
-}
cycle : Bool -> Toml.Document -> Toml.Document
cycle blankBefore document =
    document
        |> Edit.introduce [ "b" ]
            { blankBefore = blankBefore, leading = [ " why" ], trailing = Nothing }
            (Edit.string "x")
        |> Edit.remove [ "b" ]


intValue : Table.Value -> Maybe Int
intValue found =
    when found is
        Table.IntegerValue whole ->
            BigInt.toInt whole

        _ ->
            Nothing


{-| A second file, for the tests about one element of an array. Every shape a
person actually writes: a list arranged over several lines with a note against
each element, one flat, one with the bracket hanging off the first element, one
over several lines with a trailing comma and one without -- which is the shape
where the last newline belongs to the last *element* and not to the array -- the
two empty ones, one without the trailing comma *and* with a note on the last
element, where that note lives in the element's `after` and not in the array,
and one with an explanation on its own line above the closing bracket.
-}
listed : Array String
listed =
    [ "# Time zones, in the order they are shown."
    , "zones = ["
    , "  \"Asia/Seoul\",      # them"
    , "  \"America/Chicago\", # me"
    , "]"
    , "flat = [1, 2, 3]"
    , "spaced = [ 1, 2 ]"
    , "hanging = [1,"
    , "           2,"
    , "           3]"
    , "empty = []"
    , "roomy = [ ]"
    , "plain = ["
    , "  \"a\","
    , "  \"b\","
    , "]"
    , "bare = ["
    , "  1,"
    , "  2"
    , "]"
    , "noted = ["
    , "  1, # one"
    , "  2 # two"
    , "]"
    , "closed = ["
    , "  \"x\","
    , "  # end"
    , "]"
    , "notAList = 3"
    , ""
    ]


lists : String
lists =
    String.join "\n" listed


{-| The same read-change-write as [`edit`](#edit), on the file with the arrays
in it.
-}
editList : (Toml.Document -> Toml.Document) -> Result String String
editList change =
    Toml.parse lists
        |> Result.mapError Toml.errorToString
        |> Result.map (change >> Toml.toString)


{-| What the arrays file looks like with some of its lines changed.
-}
expectingList : (Array String -> Array String) -> Result String String
expectingList change =
    Ok (String.join "\n" (change listed))


{-| -}
editingSuite : U.Suite
editingSuite =
    U.suite
        { name = "Editing"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            -- THE FILE COMES BACK
            [ U.test "an untouched document is the file it came from" <| \_ ->
                Task.succeed (Expect.equal (Ok source) (edit identity))
            -- CHANGING A VALUE CHANGES ONLY THE VALUE
            , U.test "changing a value keeps the alignment around it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 5"))
                        (edit (Edit.set [ "retries" ] (Edit.int 5)))
                    )
            , U.test "and the trailing comment on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"gadget\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "gadget")))
                    )
            , U.test "a key inside a table is found through its header" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tport = 9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090)))
                    )
            , U.test "and one two levels down" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "enabled = true" "enabled = false"))
                        (edit (Edit.set [ "server", "tls", "enabled" ] (Edit.bool False)))
                    )
            , U.test "a string is escaped on the way in" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"a\\tb\"        # what it is called"
                            )
                        )
                        (edit (Edit.set [ "name" ] (Edit.string "a\tb")))
                    )
            -- ADDING A KEY
            , U.test "a new key lands with the others in its table, indented to match" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "\tport = 0x1F" "\tretries = 2"))
                        (edit (Edit.set [ "server", "retries" ] (Edit.int 2)))
                    )
            , U.test "a new top-level key lands after the last top-level key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "verbose = true"))
                        (edit (Edit.set [ "verbose" ] (Edit.bool True)))
                    )
            , U.test "a key for a table that does not exist brings a header with it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok (source ++ "\n\n[metrics]\nenabled = true"))
                        (edit (Edit.set [ "metrics", "enabled" ] (Edit.bool True)))
                    )
            , U.test "appending to a file that ends with a newline leaves it ending with one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2\n")
                        (editing "a = 1\n" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "and one that does not, still not" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n[b]\nc = 2")
                        (editing "a = 1" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a section appended to an empty file gets no blank line above it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[b]\nc = 2\n")
                        (editing "" (Edit.set [ "b", "c" ] (Edit.int 2)))
                    )
            , U.test "a top-level key in a file with none yet goes before the first header, not inside the last table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n[a]\nx = 1\n")
                        (editing "[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and above the comment block that belongs to that header" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "y = 2\n\n# about a\n[a]\nx = 1\n")
                        (editing "# about a\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "but below a comment the blank line under it gave to the document" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "# title\n\ny = 2\n\n[a]\nx = 1\n")
                        (editing "# title\n\n[a]\nx = 1\n" (Edit.set [ "y" ] (Edit.int 2)))
                    )
            , U.test "and it really is top-level: the table tree agrees" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just 2))
                        (Toml.parse "# about a\n[a]\nx = 1"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.set [ "y" ] (Edit.int 2))
                            |> Result.andThen (Table.fromDocument >> Result.mapError Table.errorToString)
                            |> Result.map (Table.get "y" >> Maybe.andThen intValue)
                        )
                    )
            -- ARRAYS OF TABLES
            , U.test "a path into an array of tables names its last item, as TOML does" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "x" ] (Edit.int 9)))
                    )
            , U.test "and a new key goes into that same item" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[[p]]\nx = 1\n\n[[p]]\nx = 2\ny = 9\n")
                        (editing "[[p]]\nx = 1\n\n[[p]]\nx = 2\n" (Edit.set [ "p", "y" ] (Edit.int 9)))
                    )
            , U.test "so get reads what set would change" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "2"))
                        (Toml.parse "[[p]]\nx = 1\n\n[[p]]\nx = 2\n"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.get [ "p", "x" ] >> Maybe.map rawOf)
                        )
                    )
            -- REMOVING A KEY, AND ITS COMMENTS
            , U.test "removing a key takes the comment block above it" <| \_ ->
                -- And the blank line above the block, since there is another
                -- one below it: two empty lines around a block that goes are
                -- one empty line once it has gone.
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines
                                [ "# How long to wait before giving up."
                                , "# Seconds, not milliseconds."
                                , "timeout = 30"
                                ]
                                >> withoutLineAfter "retries = 3"
                            )
                        )
                        (edit (Edit.remove [ "timeout" ]))
                    )
            , U.test "and the trailing comment on its own line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "name    = \"widget\"        # what it is called" ]))
                        (edit (Edit.remove [ "name" ]))
                    )
            , U.test "a key with no comment above it takes nothing extra" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (dropLines [ "retries = 3" ]))
                        (edit (Edit.remove [ "retries" ]))
                    )
            , U.test "removing a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.remove [ "nope" ])))
            -- WHAT INTRODUCE WROTE, REMOVE TAKES BACK
            , U.test "writing a key with a blank line above it and taking it out again is the identity" <| \_ ->
                -- The cycle a program runs when a setting goes back to its
                -- default. If the blank line stays behind, the file grows an
                -- empty line every time the setting is turned off.
                Task.succeed
                    (Expect.equal
                        { once = Ok "a = 1\n", thrice = Ok "a = 1\n" }
                        { once = editing "a = 1\n" (cycle True)
                        , thrice = editing "a = 1\n" (cycle True >> cycle True >> cycle True)
                        }
                    )
            , U.test "and so is the same cycle with no blank line asked for" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { once = Ok "a = 1\n", thrice = Ok "a = 1\n" }
                        { once = editing "a = 1\n" (cycle False)
                        , thrice = editing "a = 1\n" (cycle False >> cycle False >> cycle False)
                        }
                    )
            , U.test "a floating comment is left where it was by both halves of it" <| \_ ->
                let
                    floating =
                        "a = 1\n\n# a note of my own, floating\n"
                in
                Task.succeed
                    (Expect.equal (Ok floating) (editing floating (cycle True)))
            , U.test "and removing a key under one takes no comment of anybody's" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n# a note of my own, floating\n")
                        (editing "a = 1\n\n# a note of my own, floating\n\n# why\nb = \"x\"\n"
                            (Edit.remove [ "b" ])
                        )
                    )
            , U.test "the blank line that keeps a comment floating stays when a key follows" <| \_ ->
                -- Here the blank line above the block is the only thing saying
                -- the note is nobody's. Taking it would hand it to `c`.
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n# floating\n\nc = 2\n")
                        (editing "a = 1\n\n# floating\n\n# why\nb = \"x\"\nc = 2\n"
                            (Edit.remove [ "b" ])
                        )
                    )
            , U.test "and so does a blank line that is the only separator left" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\nc = 3\n")
                        (editing "a = 1\n\nb = 2\nc = 3\n" (Edit.remove [ "b" ]))
                    )
            -- THE BLANK LINE IS THE ESCAPE HATCH
            , U.test "a comment block with a blank line above it survives" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 12 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server" ]))
                    )
            -- A SECTION'S OWN BLANK LINES GO WITH IT
            , U.test "removing a table takes the whitespace inside it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                (Array.prepend (Array.takeFirst 16 before)
                                    [ "[logging]", "level = \"warn\"" ]
                                )
                            )
                        )
                        (edit (Edit.removeTable [ "server", "tls" ]))
                    )
            -- LOOKING AROUND
            , U.test "comments says which ones belong to a key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { blankBefore = True
                        , leading =
                            [ " How long to wait before giving up."
                            , " Seconds, not milliseconds."
                            ]
                        , trailing = Nothing
                        }
                        (readComments [ "timeout" ])
                    )
            , U.test "and which one is on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { blankBefore = True, leading = [], trailing = Just " what it is called" }
                        (readComments [ "name" ])
                    )
            , U.test "paths lists every key, headers resolved" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok
                            [ [ "name" ]
                            , [ "retries" ]
                            , [ "timeout" ]
                            , [ "server", "host" ]
                            , [ "server", "port" ]
                            , [ "server", "tls", "enabled" ]
                            , [ "logging", "level" ]
                            ]
                        )
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map Edit.paths
                        )
                    )
            -- EDITS COMPOSE
            , U.test "several edits in a row are still only those edits" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "retries = 3" "retries = 5"
                                >> replaceLine "\tport = 0x1F" "\tport = 8443"
                                >> dropLines [ "level = \"warn\"" ]
                                >> afterLine "\tport = 8443" "\tbacklog = 128"
                            )
                        )
                        (edit
                            (Edit.set [ "retries" ] (Edit.int 5)
                                >> Edit.set [ "server", "port" ] (Edit.int 8443)
                                >> Edit.remove [ "logging", "level" ]
                                >> Edit.set [ "server", "backlog" ] (Edit.int 128)
                            )
                        )
                    )
            -- SETTING A COMPOSITE VALUE
            , U.test "an array is written on one line, with a space after each comma" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (afterLine "timeout = 30" "ports = [80, 443]"))
                        (edit (Edit.set [ "ports" ] (Edit.array [ Edit.int 80, Edit.int 443 ])))
                    )
            , U.test "an inline table too, indented to match its neighbours" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "\tport = 0x1F"
                                "\tlimits = { soft = 1024, hard = 4096 }"
                            )
                        )
                        (edit
                            (Edit.set [ "server", "limits" ]
                                (Edit.inlineTable
                                    [ { key = "soft", value = Edit.int 1024 }
                                    , { key = "hard", value = Edit.int 4096 }
                                    ]
                                )
                            )
                        )
                    )
            , U.test "an empty one of each has no space inside it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30" "ports = []"
                                >> afterLine "ports = []" "limits = {}"
                            )
                        )
                        (edit
                            (Edit.set [ "ports" ] (Edit.array [])
                                >> Edit.set [ "limits" ] (Edit.inlineTable [])
                            )
                        )
                    )
            , U.test "and they nest, which is the only way into an inline table" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (afterLine "timeout = 30"
                                "peers = [{ name = \"alpha\" }, { name = \"beta\" }]"
                            )
                        )
                        (edit
                            (Edit.set [ "peers" ]
                                (Edit.array
                                    [ Edit.inlineTable [ { key = "name", value = Edit.string "alpha" } ]
                                    , Edit.inlineTable [ { key = "name", value = Edit.string "beta" } ]
                                    ]
                                )
                            )
                        )
                    )
            -- SETTING WHAT IS ALREADY THERE
            --
            -- The property that makes "write the whole configuration back" a
            -- safe thing for a program to do on every save. Each of these sets
            -- a value the file already has, spelled differently, and the file
            -- has to come back byte for byte -- including the spelling, which
            -- is the part a caller would lose.
            , U.test "setting a value to what it already is changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.set [ "retries" ] (Edit.int 3)))
                    )
            , U.test "and the file keeps its own spelling of the number" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.set [ "server", "port" ] (Edit.int 0x1F)))
                    )
            , U.test "respell writes it anyway, and that is the whole difference" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tport = 31"))
                        (edit (Edit.respell [ "server", "port" ] (Edit.int 31)))
                    )
            , U.test "the same value in another form is a change to respell and not to set" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { set = Ok source
                        , respell =
                            expecting
                                (replaceLine "name    = \"widget\"        # what it is called"
                                    "name    = 'widget'        # what it is called"
                                )
                        }
                        { set =
                            edit
                                (Edit.set [ "name" ]
                                    (Maybe.withDefault (Edit.string "widget")
                                        (Edit.literalString "widget")
                                    )
                                )
                        , respell =
                            edit
                                (Edit.respell [ "name" ]
                                    (Maybe.withDefault (Edit.string "widget")
                                        (Edit.literalString "widget")
                                    )
                                )
                        }
                    )
            , U.test "on a key that is not there it is exactly set" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (edit (Edit.set [ "server", "backlog" ] (Edit.int 64)))
                        (edit (Edit.respell [ "server", "backlog" ] (Edit.int 64)))
                    )
            , U.test "an array set to the same elements keeps the lines it was written on" <| \_ ->
                let
                    text =
                        "zones = [\n  \"Asia/Seoul\",     # them\n  \"America/Chicago\" # me\n]\n"
                in
                Task.succeed
                    (Expect.equal (Ok text)
                        (editing text
                            (Edit.set [ "zones" ]
                                (Edit.array
                                    [ Edit.string "Asia/Seoul", Edit.string "America/Chicago" ]
                                )
                            )
                        )
                    )
            , U.test "but reordering it is a change, and is written as one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "zones = [\"America/Chicago\", \"Asia/Seoul\"]\n")
                        (editing "zones = [\n  \"Asia/Seoul\",\n  \"America/Chicago\"\n]\n"
                            (Edit.set [ "zones" ]
                                (Edit.array
                                    [ Edit.string "America/Chicago", Edit.string "Asia/Seoul" ]
                                )
                            )
                        )
                    )
            , U.test "1.50 and 1.5 are the same number, so the file keeps 1.50" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "ratio = 1.50\n")
                        (editing "ratio = 1.50\n" (Edit.set [ "ratio" ] (Edit.float 1.5)))
                    )
            , U.test "and a different number is written" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "ratio = 1.6\n")
                        (editing "ratio = 1.50\n" (Edit.set [ "ratio" ] (Edit.float 1.6)))
                    )
            , U.test "a literal string and a basic one with the same characters are equal" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "name = 'widget'\n")
                        (editing "name = 'widget'\n" (Edit.set [ "name" ] (Edit.string "widget")))
                    )
            , U.test "an inline table with its entries in another order is a change" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "limits = { hard = 4096, soft = 1024 }\n")
                        (editing "limits = { soft = 1024, hard = 4096 }\n"
                            (Edit.set [ "limits" ]
                                (Edit.inlineTable
                                    [ { key = "hard", value = Edit.int 4096 }
                                    , { key = "soft", value = Edit.int 1024 }
                                    ]
                                )
                            )
                        )
                    )
            , U.test "a value of another type is a change even when it reads the same" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "n = \"1\"\n")
                        (editing "n = 1\n" (Edit.set [ "n" ] (Edit.string "1")))
                    )
            -- IS IT THERE
            , U.test "member says whether a key is in the file" <| \_ ->
                Task.succeed
                    (Expect.equal { there = True, absent = False }
                        (when Toml.parse source is
                            Ok document ->
                                { there = Edit.member [ "server", "port" ] document
                                , absent = Edit.member [ "server", "nope" ] document
                                }

                            Err _ ->
                                { there = False, absent = True }
                        )
                    )
            -- WRITING COMMENTS
            , U.test "a comment added to a line that had none gets a space in front of it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "retries = 3 # why so few"))
                        (edit
                            (Edit.setComments [ "retries" ]
                                { blankBefore = False, leading = [], trailing = Just " why so few" }
                            )
                        )
                    )
            , U.test "and one replacing another keeps the alignment that was there" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\"        # renamed"
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { blankBefore = True, leading = [], trailing = Just " renamed" }
                            )
                        )
                    )
            , U.test "taking one off takes the whitespace before it too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine
                                "name    = \"widget\"        # what it is called"
                                "name    = \"widget\""
                            )
                        )
                        (edit
                            (Edit.setComments [ "name" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "a leading block replaces the one that was above the key" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (dropLines [ "# Seconds, not milliseconds." ]
                                >> replaceLine
                                    "# How long to wait before giving up."
                                    "# Seconds. Not milliseconds."
                            )
                        )
                        (edit
                            (Edit.setComments [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds. Not milliseconds." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "and a new block is indented to match the key it explains" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\tport = 0x1F" "\t# The one to listen on."))
                        (edit
                            (Edit.setComments [ "server", "port" ]
                                { blankBefore = False
                                , leading = [ " The one to listen on." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "the floating block above [server] is not the key's to replace" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "\thost = \"example.com\"" "\t# The host."))
                        (edit
                            (Edit.setComments [ "server", "host" ]
                                { blankBefore = False
                                , leading = [ " The host." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "reading the comments and writing them back changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setComments path (Edit.comments path document) soFar
                                    )
                                    document
                                    (Edit.paths document)
                            )
                        )
                    )
            -- A HEADER'S OWN COMMENTS
            , U.test "tableComments reads the block over a header, and a floating one is not it" <| \_ ->
                -- The block above [server] has a blank line under it, so it is
                -- nobody's; all the header owns is the blank.
                Task.succeed
                    (Expect.equal
                        (Ok { blankBefore = True, leading = [], trailing = Nothing })
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Edit.tableComments [ "server" ])
                        )
                    )
            , U.test "setTableComments explains a section" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (beforeLine "[server.tls]" "# Encryption."
                                >> replaceLine "[server.tls]" "[server.tls] # off by default"
                            )
                        )
                        (edit
                            (Edit.setTableComments [ "server", "tls" ]
                                { blankBefore = True
                                , leading = [ " Encryption." ]
                                , trailing = Just " off by default"
                                }
                            )
                        )
                    )
            , U.test "reading a header's comments and writing them back changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setTableComments path (Edit.tableComments path document) soFar
                                    )
                                    document
                                    [ [ "server" ], [ "server", "tls" ], [ "logging" ] ]
                            )
                        )
                    )
            , U.test "for an array of tables it is the first header, where Encode puts them" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "# Everyone we talk to.\n[[peer]]\nn = 1\n\n[[peer]]\nn = 2\n")
                        (editing "[[peer]]\nn = 1\n\n[[peer]]\nn = 2\n"
                            (Edit.setTableComments [ "peer" ]
                                { blankBefore = True
                                , leading = [ " Everyone we talk to." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            , U.test "a table with no header line has nothing to read and nothing to write on" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { read = { blankBefore = False, leading = [], trailing = Nothing }
                        , written = Ok "a.b = 1\n"
                        }
                        { read =
                            Toml.parse "a.b = 1\n"
                                |> Result.map (Edit.tableComments [ "a" ])
                                |> Result.withDefault { blankBefore = True, leading = [ "?" ], trailing = Nothing }
                        , written =
                            editing "a.b = 1\n"
                                (Edit.setTableComments [ "a" ]
                                    { blankBefore = False, leading = [ " nope" ], trailing = Nothing }
                                )
                        }
                    )
            , U.test "a nested header directly under its parent may have its blank line, unlike a key" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[a]\n\n[a.b]\n")
                        (editing "[a]\n[a.b]\n"
                            (Edit.setTableComments [ "a", "b" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            -- THE BLANK LINE ABOVE A COMMENT BLOCK
            , U.test "the first key of a file has no blank line above it" <| \_ ->
                -- Array.get -1 is the last element in Gren, and the last
                -- expression of a file that ends with a newline is blank.
                Task.succeed
                    (Expect.equal (Ok False)
                        (Toml.parse "a = 1\n"
                            |> Result.mapError Toml.errorToString
                            |> Result.map (\document -> (Edit.comments [ "a" ] document).blankBefore)
                        )
                    )
            , U.test "blankBefore puts an empty line above the block" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (beforeLine "retries = 3" ""))
                        (edit
                            (Edit.setComments [ "retries" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "and False takes one away" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (withoutLineAfter "# A config file with opinions about whitespace."
                                >> withoutLineAfter "retries = 3"
                            )
                        )
                        (edit
                            (\document ->
                                Array.foldl
                                    (\path soFar ->
                                        Edit.setComments path
                                            { blankBefore = False
                                            , leading = (Edit.comments path document).leading
                                            , trailing = (Edit.comments path document).trailing
                                            }
                                            soFar
                                    )
                                    document
                                    (Edit.paths document)
                            )
                        )
                    )
            , U.test "asking for one at the top of the file does nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n")
                        (editing "a = 1\n"
                            (Edit.setComments [ "a" ]
                                { blankBefore = True, leading = [], trailing = Nothing }
                            )
                        )
                    )
            , U.test "nor directly under a header, where the key belongs against it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "[server]\n# The one to listen on.\nport = 1\n")
                        (editing "[server]\nport = 1\n"
                            (Edit.setComments [ "server", "port" ]
                                { blankBefore = True
                                , leading = [ " The one to listen on." ]
                                , trailing = Nothing
                                }
                            )
                        )
                    )
            -- INTRODUCE
            , U.test "introduce explains a key it is the one to invent" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = 1\n\n# Seconds.\ntimeout = 30\n")
                        (editing "a = 1\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 30)
                            )
                        )
                    )
            , U.test "and says nothing about one that was already there" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "timeout = 45\n")
                        (editing "timeout = 30\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 45)
                            )
                        )
                    )
            , U.test "not even when the explanation it would have written is gone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "timeout = 30\n")
                        (editing "timeout = 30\n"
                            (Edit.introduce [ "timeout" ]
                                { blankBefore = True
                                , leading = [ " Seconds." ]
                                , trailing = Nothing
                                }
                                (Edit.int 30)
                            )
                        )
                    )
            -- THE FILE THAT IS NOT THERE YET
            , U.test "an empty document writes as nothing at all" <| \_ ->
                Task.succeed (Expect.equal "" (Toml.toString Toml.empty))
            , U.test "and creating a file is the same code as changing one" <| \_ ->
                let
                    write document =
                        document
                            |> Edit.introduce
                                [ "theme" ]
                                { blankBefore = True
                                , leading = [ " Which scheme to open in." ]
                                , trailing = Nothing
                                }
                                (Edit.string "dark")
                            |> Edit.introduce
                                [ "zones" ]
                                { blankBefore = True
                                , leading = [ " In the order they are shown." ]
                                , trailing = Nothing
                                }
                                (Edit.array [ Edit.string "Asia/Seoul" ])
                in
                Task.succeed
                    (Expect.equal
                        (Ok
                            (String.join "\n"
                                [ "# Which scheme to open in."
                                , "theme = \"dark\""
                                , ""
                                , "# In the order they are shown."
                                , "zones = [\"Asia/Seoul\"]"
                                , ""
                                ]
                            )
                        )
                        (Ok (Toml.toString (write Toml.empty)))
                    )
            , U.test "and the second run over that file changes only what moved" <| \_ ->
                let
                    once =
                        Toml.toString
                            (Edit.introduce [ "theme" ]
                                { blankBefore = True, leading = [ " Scheme." ], trailing = Nothing }
                                (Edit.string "dark")
                                Toml.empty
                            )
                in
                Task.succeed
                    (Expect.equal (Ok "# Scheme.\ntheme = \"gren\"\n")
                        (editing once
                            (Edit.introduce [ "theme" ]
                                { blankBefore = True, leading = [ " Scheme." ], trailing = Nothing }
                                (Edit.string "gren")
                            )
                        )
                    )
            , U.test "a key that brings its own header is not held off it by its blank line" <| \_ ->
                -- The first run of a config program is exactly this: every
                -- key asks for a blank above its explanation, and the first
                -- key of each new table would otherwise land under an empty
                -- line -- `[server]`, blank, comment, key.
                let
                    explained text =
                        { blankBefore = True, leading = [ text ], trailing = Nothing }
                in
                Task.succeed
                    (Expect.equal
                        (String.join "\n"
                            [ "# Scheme."
                            , "theme = \"dark\""
                            , ""
                            , "[server]"
                            , "# Port."
                            , "port = 1"
                            , ""
                            , "# Host."
                            , "host = \"h\""
                            , ""
                            ]
                        )
                        (Toml.empty
                            |> Edit.introduce [ "theme" ] (explained " Scheme.") (Edit.string "dark")
                            |> Edit.introduce [ "server", "port" ] (explained " Port.") (Edit.int 1)
                            |> Edit.introduce [ "server", "host" ] (explained " Host.") (Edit.string "h")
                            |> Toml.toString
                        )
                    )
            , U.test "and the file it writes is the file Encode writes for the same shape" <| \_ ->
                -- The two modules decide their blank lines in different
                -- places -- `tidyBlanks` there, `spacedTo` here -- and this is
                -- what keeps them deciding the same thing.
                let
                    explained text =
                        { blankBefore = True, leading = [ text ], trailing = Nothing }

                    edited =
                        Toml.empty
                            |> Edit.introduce [ "theme" ] (explained " Scheme.") (Edit.string "dark")
                            |> Edit.introduce [ "server", "port" ] (explained " Port.") (Edit.int 1)
                            |> Edit.introduce [ "server", "host" ] (explained " Host.") (Edit.string "h")
                            |> Edit.setTableComments [ "server" ] (explained " Where to reach it.")
                            |> Toml.toString

                    encoded =
                        Encode.toString
                            [ Encode.field "theme" (Encode.string "dark")
                                |> Encode.commented { leading = [ " Scheme." ], trailing = Nothing }
                            , Encode.field "server"
                                (Encode.table
                                    [ Encode.field "port" (Encode.int 1)
                                        |> Encode.commented { leading = [ " Port." ], trailing = Nothing }
                                    , Encode.field "host" (Encode.string "h")
                                        |> Encode.commented { leading = [ " Host." ], trailing = Nothing }
                                    ]
                                )
                                |> Encode.commented { leading = [ " Where to reach it." ], trailing = Nothing }
                            ]
                in
                Task.succeed (Expect.equal encoded edited)
            , U.test "an empty file parses to Toml.empty, so first run and empty file are one case" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok Toml.empty)
                        (Toml.parse "" |> Result.mapError Toml.errorToString)
                    )
            -- RENAMING
            , U.test "renaming a key changes the name and nothing else on the line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "\tport = 0x1F" "\tlisten = 0x1F"))
                        (edit (Edit.rename [ "server", "port" ] "listen"))
                    )
            , U.test "a name the grammar will not take bare is quoted" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "retries = 3" "\"max retries\" = 3"))
                        (edit (Edit.rename [ "retries" ] "max retries"))
                    )
            , U.test "renaming a key that is not there changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source) (edit (Edit.rename [ "nope" ] "x")))
            , U.test "renaming a table takes its headers and the ones nested under it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting
                            (replaceLine "[server]" "[listener]"
                                >> replaceLine "[server.tls]" "[listener.tls]"
                            )
                        )
                        (edit (Edit.renameTable [ "server" ] "listener"))
                    )
            , U.test "and a comment that talks about [server] is still a comment" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok True)
                        (edit (Edit.renameTable [ "server" ] "listener")
                            |> Result.map
                                (String.contains
                                    "must survive anything done to [server]"
                                )
                        )
                    )
            , U.test "only the last part of the path is the new name" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expecting (replaceLine "[server.tls]" "[server.secure]"))
                        (edit (Edit.renameTable [ "server", "tls" ] "secure"))
                    )
            , U.test "renameTable will not rename a key, since a key is not a table" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok source)
                        (edit (Edit.renameTable [ "server", "port" ] "listen"))
                    )
            , U.test "a table a dotted key wrote is renamed where the key spells it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "x.b = 1\nx.c = 2\nb = 3")
                        (editing "a.b = 1\na.c = 2\nb = 3"
                            (Edit.renameTable [ "a" ] "x")
                        )
                    )
            , U.test "and the last part of a dotted key is the value, so it is left alone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a.b = 1")
                        (editing "a.b = 1" (Edit.renameTable [ "a", "b" ] "z"))
                    )
            -- THE BYTES BACK
            , U.test "toBytes is the file the document came from" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just source))
                        (Toml.parse source
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.toString)
                        )
                    )
            , U.test "and it carries a byte order mark back, which a String cannot say" <| \_ ->
                let
                    original =
                        Bytes.fromString ("\u{FEFF}" ++ source)
                in
                Task.succeed
                    (Expect.equal (Ok (Bytes.length original))
                        (Toml.parseBytes original
                            |> Result.mapError Toml.errorToString
                            |> Result.map (Toml.toBytes >> Bytes.length)
                        )
                    )
            , U.test "unless the String still has the mark, which parse then keeps too" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok ("\u{FEFF}" ++ source))
                        (Toml.parse ("\u{FEFF}" ++ source)
                            |> Result.mapError Toml.errorToString
                            |> Result.map Toml.toString
                        )
                    )
            -- AND THE RESULT IS STILL A TOML FILE
            , U.test "what comes out parses again to what was asked for" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok (Just "9090"))
                        (edit (Edit.set [ "server", "port" ] (Edit.int 9090))
                            |> Result.andThen
                                (\written ->
                                    Toml.parse written
                                        |> Result.mapError Toml.errorToString
                                        |> Result.map
                                            (\document ->
                                                Edit.get [ "server", "port" ] document
                                                    |> Maybe.map rawOf
                                            )
                                )
                        )
                    )
            -- ONE ELEMENT OF AN ARRAY, AND NOTHING ELSE
            , U.test "the file with the arrays in it comes back untouched too" <| \_ ->
                Task.succeed (Expect.equal (Ok lists) (editList identity))
            , U.test "appending keeps the other elements' lines and notes" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (afterLine "  \"America/Chicago\", # me" "  \"Europe/Oslo\",")
                        )
                        (editList (Edit.appendTo [ "zones" ] (Edit.string "Europe/Oslo")))
                    )
            , U.test "and what it wrote says what it should" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok [ "Asia/Seoul", "America/Chicago", "Europe/Oslo" ])
                        (editList (Edit.appendTo [ "zones" ] (Edit.string "Europe/Oslo"))
                            |> Result.andThen
                                (\written ->
                                    Decode.fromString
                                        (Decode.field "zones" (Decode.array Decode.string))
                                        written
                                        |> Result.mapError Decode.errorToString
                                )
                        )
                    )
            , U.test "an array on one line stays on one line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "flat = [1, 2, 3]" "flat = [1, 2, 3, 4]"))
                        (editList (Edit.appendTo [ "flat" ] (Edit.int 4)))
                    )
            , U.test "and the spaces inside its brackets stay where they are" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "spaced = [ 1, 2 ]" "spaced = [ 1, 2, 3 ]"))
                        (editList (Edit.appendTo [ "spaced" ] (Edit.int 3)))
                    )
            , U.test "a hanging bracket keeps hanging" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (replaceLine "           3]" "           3,\n           4]")
                        )
                        (editList (Edit.appendTo [ "hanging" ] (Edit.int 4)))
                    )
            , U.test "an empty array is filled without gaining spaces" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "empty = []" "empty = [1]"))
                        (editList (Edit.appendTo [ "empty" ] (Edit.int 1)))
                    )
            , U.test "and one written with a space inside keeps it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "roomy = [ ]" "roomy = [ 1 ]"))
                        (editList (Edit.appendTo [ "roomy" ] (Edit.int 1)))
                    )
            , U.test "a trailing comma is kept, since the file had one" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (afterLine "  \"b\"," "  \"c\","))
                        (editList (Edit.appendTo [ "plain" ] (Edit.string "c")))
                    )
            , U.test "a key that is not there yet becomes a one-element array" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (afterLine "notAList = 3" "brand = [1]"))
                        (editList (Edit.appendTo [ "brand" ] (Edit.int 1)))
                    )
            , U.test "a key that is not an array is left alone" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists)
                        (editList (Edit.appendTo [ "notAList" ] (Edit.int 1)))
                    )
            , U.test "an array whose last element carries the closing newline gains a line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "  2" "  2,\n  3"))
                        (editList (Edit.appendTo [ "bare" ] (Edit.int 3)))
                    )
            -- PUTTING ONE IN THE MIDDLE
            , U.test "inserting takes the line of the element it displaces" <| \_ ->
                -- And the note above it stays where it is, which is why the
                -- whole file is what this compares.
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (beforeLine "  \"America/Chicago\", # me" "  \"Europe/Oslo\",")
                        )
                        (editList (Edit.insertAt [ "zones" ] 1 (Edit.string "Europe/Oslo")))
                    )
            , U.test "inserting at the front pushes the first element down a line" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (beforeLine "  \"Asia/Seoul\",      # them" "  \"Europe/Oslo\",")
                        )
                        (editList (Edit.insertAt [ "zones" ] 0 (Edit.string "Europe/Oslo")))
                    )
            , U.test "an array on one line keeps the separator it writes between elements" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { atTheFront = expectingList (replaceLine "flat = [1, 2, 3]" "flat = [0, 1, 2, 3]")
                        , inTheMiddle = expectingList (replaceLine "flat = [1, 2, 3]" "flat = [1, 2, 9, 3]")
                        }
                        { atTheFront = editList (Edit.insertAt [ "flat" ] 0 (Edit.int 0))
                        , inTheMiddle = editList (Edit.insertAt [ "flat" ] 2 (Edit.int 9))
                        }
                    )
            , U.test "a hanging bracket keeps its column when a line is added to it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (beforeLine "           2," "           9,"))
                        (editList (Edit.insertAt [ "hanging" ] 1 (Edit.int 9)))
                    )
            , U.test "an index equal to the length is an append" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (editList (Edit.appendTo [ "zones" ] (Edit.string "Europe/Oslo")))
                        (editList (Edit.insertAt [ "zones" ] 2 (Edit.string "Europe/Oslo")))
                    )
            , U.test "an index past the end has no line to take, and neither has a negative one" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { past = Ok lists, negative = Ok lists }
                        { past = editList (Edit.insertAt [ "zones" ] 3 (Edit.string "Europe/Oslo"))
                        , negative = editList (Edit.insertAt [ "flat" ] -1 (Edit.int 0))
                        }
                    )
            , U.test "a key that is not there yet becomes a one-element array at 0 and nothing anywhere else" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { atZero = expectingList (afterLine "notAList = 3" "brand = [1]")
                        , atOne = Ok lists
                        }
                        { atZero = editList (Edit.insertAt [ "brand" ] 0 (Edit.int 1))
                        , atOne = editList (Edit.insertAt [ "brand" ] 1 (Edit.int 1))
                        }
                    )
            -- MOVING ONE TAKES ITS NOTE ALONG
            , U.test "moving an element writes its note against it in its new place" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (swapLines "  \"Asia/Seoul\",      # them"
                                "  \"America/Chicago\", # me"
                            )
                        )
                        (editList (Edit.moveAt [ "zones" ] 1 0))
                    )
            , U.test "and what it wrote is the same list in the new order" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok [ "America/Chicago", "Asia/Seoul" ])
                        (editList (Edit.moveAt [ "zones" ] 1 0)
                            |> Result.andThen
                                (\written ->
                                    Decode.fromString
                                        (Decode.field "zones" (Decode.array Decode.string))
                                        written
                                        |> Result.mapError Decode.errorToString
                                )
                        )
                    )
            , U.test "and moving it back is the file it started as" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists)
                        (editList (Edit.moveAt [ "zones" ] 1 0 >> Edit.moveAt [ "zones" ] 0 1))
                    )
            , U.test "only the element that moved changes lines" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok "z = [\n  \"C\", # c\n  \"A\", # a\n  \"B\", # b\n]\n")
                        (editing "z = [\n  \"A\", # a\n  \"B\", # b\n  \"C\", # c\n]\n"
                            (Edit.moveAt [ "z" ] 2 0)
                        )
                    )
            , U.test "and a move of one place is the two lines swapping" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (Ok "z = [\n  \"A\", # a\n  \"C\", # c\n  \"B\", # b\n]\n")
                        (editing "z = [\n  \"A\", # a\n  \"B\", # b\n  \"C\", # c\n]\n"
                            (Edit.moveAt [ "z" ] 2 1)
                        )
                    )
            , U.test "the indent and the comma are the destination's, note and all" <| \_ ->
                -- Into the last place, where the element carries the newline
                -- the closing bracket needs and has no comma of its own.
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (replaceLine "  1, # one" "  2, # two"
                                >> replaceLine "  2 # two" "  1 # one"
                            )
                        )
                        (editList (Edit.moveAt [ "noted" ] 0 1))
                    )
            , U.test "and out of the last place, which is the same swap the other way" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (editList (Edit.moveAt [ "noted" ] 0 1))
                        (editList (Edit.moveAt [ "noted" ] 1 0))
                    )
            , U.test "a hanging bracket keeps its column when an element moves" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (replaceLine "           2," "           3,"
                                >> replaceLine "           3]" "           2]"
                            )
                        )
                        (editList (Edit.moveAt [ "hanging" ] 1 2))
                    )
            , U.test "an element with a note will not move onto a line another element ends" <| \_ ->
                -- There is nowhere on the line `2` and `3` share to write
                -- `# one`, and writing it against either of them would be a
                -- note against a value nobody wrote it for.
                let
                    shared =
                        "a = [\n  1, # one\n  2, 3,\n]\n"
                in
                Task.succeed
                    (Expect.equal (Ok shared) (editing shared (Edit.moveAt [ "a" ] 0 1)))
            , U.test "and without the note the same move is only the values changing places" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok "a = [\n  2, 1, 3,\n]\n")
                        (editing "a = [\n  1,\n  2, 3,\n]\n" (Edit.moveAt [ "a" ] 0 1))
                    )
            , U.test "moving an element to where it already is changes nothing at all" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists) (editList (Edit.moveAt [ "zones" ] 1 1)))
            , U.test "and an index out of range at either end changes nothing either" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { from = Ok lists, to = Ok lists, negative = Ok lists }
                        { from = editList (Edit.moveAt [ "zones" ] 2 0)
                        , to = editList (Edit.moveAt [ "zones" ] 0 2)
                        , negative = editList (Edit.moveAt [ "zones" ] -1 0)
                        }
                    )
            -- TAKING ONE OUT TAKES ITS NOTE WITH IT
            , U.test "removing the first element leaves the second where it was" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  \"Asia/Seoul\",      # them" ]))
                        (editList (Edit.removeAt [ "zones" ] 0))
                    )
            , U.test "and removing the last one moves the closing bracket up, not the notes" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  \"America/Chicago\", # me" ]))
                        (editList (Edit.removeAt [ "zones" ] 1))
                    )
            , U.test "removing from the middle of a one-line array leaves one separator" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "flat = [1, 2, 3]" "flat = [1, 3]"))
                        (editList (Edit.removeAt [ "flat" ] 1))
                    )
            , U.test "removing the first leaves nothing against the bracket" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "flat = [1, 2, 3]" "flat = [2, 3]"))
                        (editList (Edit.removeAt [ "flat" ] 0))
                    )
            , U.test "and removing the last leaves nothing against the closing one" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "flat = [1, 2, 3]" "flat = [1, 2]"))
                        (editList (Edit.removeAt [ "flat" ] 2))
                    )
            , U.test "the spaces inside the brackets survive that too" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "spaced = [ 1, 2 ]" "spaced = [ 1 ]"))
                        (editList (Edit.removeAt [ "spaced" ] 1))
                    )
            , U.test "a hanging bracket stays hanging when the last element goes" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (dropLines [ "           3]" ]
                                >> replaceLine "           2," "           2]"
                            )
                        )
                        (editList (Edit.removeAt [ "hanging" ] 2))
                    )
            , U.test "the last element's trailing comma passes to the one before it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  \"b\"," ]))
                        (editList (Edit.removeAt [ "plain" ] 1))
                    )
            , U.test "and loses one again, closing bracket and all, when it shrinks" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  2" ] >> replaceLine "  1," "  1"))
                        (editList (Edit.removeAt [ "bare" ] 1))
                    )
            , U.test "an index that is not in the array changes nothing" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists) (editList (Edit.removeAt [ "zones" ] 2)))
            , U.test "and a negative one is out of range, not counted from the end" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists) (editList (Edit.removeAt [ "zones" ] -1)))
            , U.test "an empty array has nothing to take out of it" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists) (editList (Edit.removeAt [ "roomy" ] 0)))
            -- THE NOTE ON A BARE LAST ELEMENT IS IN ITS AFTER, NOT IN THE ARRAY
            , U.test "appending after a bare last element keeps its note on it" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (replaceLine "  2 # two" "  2, # two\n  3"))
                        (editList (Edit.appendTo [ "noted" ] (Edit.int 3)))
                    )
            , U.test "and removing it takes that note, not the one above" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (dropLines [ "  2 # two" ] >> replaceLine "  1, # one" "  1 # one")
                        )
                        (editList (Edit.removeAt [ "noted" ] 1))
                    )
            , U.test "removing the one above leaves the bare one as it was" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  1, # one" ]))
                        (editList (Edit.removeAt [ "noted" ] 0))
                    )
            -- A NOTE ON ITS OWN LINE ABOVE THE BRACKET STAYS THERE
            , U.test "appending goes above an explanation that sits against the bracket" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (afterLine "  \"x\"," "  \"y\","))
                        (editList (Edit.appendTo [ "closed" ] (Edit.string "y")))
                    )
            , U.test "and removing the last element leaves that explanation alone" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList (dropLines [ "  \"x\"," ]))
                        (editList (Edit.removeAt [ "closed" ] 0))
                    )
            -- REPLACING ONE ELEMENT TOUCHES ONE ELEMENT
            , U.test "setting an element by position leaves its note and the alignment" <| \_ ->
                Task.succeed
                    (Expect.equal
                        (expectingList
                            (replaceLine "  \"America/Chicago\", # me" "  \"America/Denver\", # me")
                        )
                        (editList (Edit.setAt [ "zones" ] 1 (Edit.string "America/Denver")))
                    )
            , U.test "and setting it to what it already says changes nothing at all" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists)
                        (editList (Edit.setAt [ "zones" ] 1 (Edit.string "America/Chicago")))
                    )
            , U.test "respellAt writes the other spelling of the same value" <| \_ ->
                Task.succeed
                    (Expect.equal
                        { setAt = Ok lists
                        , respellAt =
                            expectingList
                                (replaceLine "  \"America/Chicago\", # me"
                                    "  'America/Chicago', # me"
                                )
                        }
                        { setAt =
                            editList
                                (Edit.setAt [ "zones" ] 1 (literally "America/Chicago"))
                        , respellAt =
                            editList
                                (Edit.respellAt [ "zones" ] 1 (literally "America/Chicago"))
                        }
                    )
            , U.test "and an index that is not there is nowhere to write one" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists)
                        (editList (Edit.respellAt [ "zones" ] 2 (literally "Europe/Oslo")))
                    )
            , U.test "an index that is not there changes nothing either" <| \_ ->
                Task.succeed
                    (Expect.equal (Ok lists) (editList (Edit.setAt [ "flat" ] -1 (Edit.int 9))))
            ]
        }


{-| A string as a literal one, `'like this'`, falling back to a basic string for
a string that cannot be written that way. Every one in this file can be.
-}
literally : String -> Edit.Value
literally text =
    Maybe.withDefault (Edit.string text) (Edit.literalString text)


readComments : Array String -> Edit.Comments
readComments path =
    when Toml.parse source is
        Ok document ->
            Edit.comments path document

        Err _ ->
            { blankBefore = False, leading = [], trailing = Nothing }


rawOf : Ast.Value -> String
rawOf content =
    when content is
        Ast.IntegerVal fields ->
            fields.raw

        _ ->
            "?"
