bad : Array Bad
bad =
    [ { raw = "\"\\xAg\"", file = "invalid/string/bad-byte-escape.toml" }
    , { raw = "\"This string has a bad \\a escape character.\"", file = "invalid/string/bad-escape-01.toml" }
    , { raw = "\"This string has a bad \\  escape character.\"", file = "invalid/string/bad-escape-02.toml" }
    , { raw = "\"a \\\\\\ b\"", file = "invalid/string/bad-escape-04.toml" }
    , { raw = "\"a \\\\\\\\\\ b\"", file = "invalid/string/bad-escape-05.toml" }
    , { raw = "\"\\x0g\"", file = "invalid/string/bad-hex-esc-01.toml" }
    , { raw = "\"\\xG0\"", file = "invalid/string/bad-hex-esc-02.toml" }
    , { raw = "\"\\x\"", file = "invalid/string/bad-hex-esc-03.toml" }
    , { raw = "\"\\x 50\"", file = "invalid/string/bad-hex-esc-04.toml" }
    , { raw = "\"\\x 50\"", file = "invalid/string/bad-hex-esc-05.toml" }
    , { raw = "\"This string has a bad \\/ escape character.\"", file = "invalid/string/bad-slash-escape.toml" }
    , { raw = "\"val\\ue\"", file = "invalid/string/bad-uni-esc-01.toml" }
    , { raw = "\"val\\Ux\"", file = "invalid/string/bad-uni-esc-02.toml" }
    , { raw = "\"val\\U0000000\"", file = "invalid/string/bad-uni-esc-03.toml" }
    , { raw = "\"val\\U0000\"", file = "invalid/string/bad-uni-esc-04.toml" }
    , { raw = "\"val\\Ugggggggg\"", file = "invalid/string/bad-uni-esc-05.toml" }
    , { raw = "\"This string contains a non scalar unicode codepoint \\uD801\"", file = "invalid/string/bad-uni-esc-06.toml" }
    , { raw = "\"\\uabag\"", file = "invalid/string/bad-uni-esc-07.toml" }
    , { raw = "\"\"\"val\\ue\"\"\"", file = "invalid/string/bad-uni-esc-ml-01.toml" }
    , { raw = "\"\"\"val\\Ux\"\"\"", file = "invalid/string/bad-uni-esc-ml-02.toml" }
    , { raw = "\"\"\"val\\U0000000\"\"\"", file = "invalid/string/bad-uni-esc-ml-03.toml" }
    , { raw = "\"\"\"val\\U0000\"\"\"", file = "invalid/string/bad-uni-esc-ml-04.toml" }
    , { raw = "\"\"\"val\\Ugggggggg\"\"\"", file = "invalid/string/bad-uni-esc-ml-05.toml" }
    , { raw = "\"\"\"This string contains a non scalar unicode codepoint \\uD801\"\"\"", file = "invalid/string/bad-uni-esc-ml-06.toml" }
    , { raw = "\"\"\"\\uabag\"\"\"", file = "invalid/string/bad-uni-esc-ml-07.toml" }
    , { raw = "\"\"\"\\UFFFFFFFF\"\"\"", file = "invalid/string/basic-multiline-out-of-range-unicode-escape-01.toml" }
    , { raw = "\"\"\"\\U00D80000\"\"\"", file = "invalid/string/basic-multiline-out-of-range-unicode-escape-02.toml" }
    , { raw = "\"\"\"\\@\"\"\"", file = "invalid/string/basic-multiline-unknown-escape.toml" }
    , { raw = "\"\\UFFFFFFFF\"", file = "invalid/string/basic-out-of-range-unicode-escape-01.toml" }
    , { raw = "\"\\U00D80000\"", file = "invalid/string/basic-out-of-range-unicode-escape-02.toml" }
    , { raw = "\"\\@\"", file = "invalid/string/basic-unknown-escape.toml" }
    , { raw = "\"\"\"t\\a\"\"\"", file = "invalid/string/multiline-bad-escape-01.toml" }
    , { raw = "\"\"\"\n  foo \\ \\n\n  bar\"\"\"", file = "invalid/string/multiline-escape-space-01.toml" }
    , { raw = "\"\"\"\nhee \\\n\ngee \\   \"\"\"", file = "invalid/string/multiline-escape-space-02.toml" }
    ]


{-| -}
literalsSuite : U.Suite
literalsSuite =
    U.suite
        { name = "Literals"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = \_ -> Task.succeed {}
        , tearDown = U.noTearDown
        , tests =
            -- A generated table that came out empty would pass everything
            -- below it without checking anything.
            [ U.test "the tables are the size toml-test says they are" <| \_ ->
                Task.succeed
                    (Expect.equal { good = 133, bad = 34 }
                        { good = Array.length good, bad = Array.length bad }
                    )
            , U.test "every literal toml-test accepts reads as the expected string" <| \_ ->
                Task.succeed
                    (Expect.equal []
                        (good
                            |> Array.keepIf (\row -> Strings.value row.raw /= Just row.want)
                            |> Array.map
                                (\row ->
                                    row.file
                                        ++ ": "
                                        ++ row.raw
                                        ++ " -> "
                                        ++ describe (Strings.value row.raw)
                                        ++ ", wanted "
                                        ++ row.want
                                )
                        )
                    )
            , U.test "and every one it rejects reads as nothing" <| \_ ->
                Task.succeed
                    (Expect.equal []
                        (bad
                            |> Array.keepIf (\row -> Strings.value row.raw /= Nothing)
                            |> Array.map (\row -> row.file ++ ": " ++ row.raw)
                        )
                    )
            ]
        }


describe : Maybe String -> String
describe result =
    when result is
        Just text ->
            text

        Nothing ->
            "nothing"
