module Literals exposing (literalsSuite)

{-| Every string literal in the official TOML test suite.

133 that must read as a particular string and 34 that must not read at all,
lifted out of `toml-test`'s string and key directories and filtered to the
`files-toml-1.1.0` manifest. 48 cases were skipped: a literal `Toml.Strings` is
not being asked about, because it never ends, or because the file is not valid
UTF-8 and so never reaches this layer at all.

The interesting ones are the multi-line quotes. `"""lol\\""""""` is a string
containing `lol"""`, and `""""one quote""""` is one containing `"one quote"`,
because `mlb-quotes` lets a body end with one or two more delimiters than it
looks like it should. The extractor has its own scanner for where a literal
ends, written from the grammar rather than from the parser, so the two have to
agree independently.

@docs literalsSuite

-}

import Array exposing (Array)
import Basics exposing (..)
import Expect
import Maybe exposing (Maybe(..))
import String
import Task
import Test.Runner.UnitNode as U
import Toml.Strings as Strings


type alias Good =
    { raw : String, want : String, file : String }


type alias Bad =
    { raw : String, file : String }


good : Array Good
good =
    [ { raw = "\"\\\"one\\\"\"", want = "\"one\"", file = "valid/string/basic-escape-01.toml" }
    , { raw = "\"\\\\\\\"one\"", want = "\\\"one", file = "valid/string/basic-escape-02.toml" }
    , { raw = "\"\\\\\\\\\\\\\\\\\\\"one\"", want = "\\\\\\\\\"one", file = "valid/string/basic-escape-03.toml" }
    , { raw = "\"\"", want = "", file = "valid/string/empty.toml" }
    , { raw = "\"\"\"\nheeee\ngeeee\\  \n\n\n      \"\"\"", want = "heeee\ngeeee", file = "valid/string/ends-in-whitespace-escape.toml" }
    , { raw = "\"\\e There is no escape! \\e\"", want = "\u{001b} There is no escape! \u{001b}", file = "valid/string/escape-esc.toml" }
    , { raw = "\"String does not end here\\\" but ends here\\\\\"", want = "String does not end here\" but ends here\\", file = "valid/string/escape-tricky.toml" }
    , { raw = "'String ends here\\'", want = "String ends here\\", file = "valid/string/escape-tricky.toml" }
    , { raw = "'''There is no escape\\'''", want = "There is no escape\\", file = "valid/string/escape-tricky.toml" }
    , { raw = "'''\n\\u007f'''", want = "\\u007f", file = "valid/string/escape-tricky.toml" }
    , { raw = "\"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"", want = "When will it end? \"\"\"...\"\"\" should be here\"", file = "valid/string/escape-tricky.toml" }
    , { raw = "\"\"\"\n\\\\u0041\"\"\"", want = "\\u0041", file = "valid/string/escape-tricky.toml" }
    , { raw = "\"\"\"\n\\u00a0\"\"\"", want = " ", file = "valid/string/escape-tricky.toml" }
    , { raw = "\"\\\\x64\"", want = "\\x64", file = "valid/string/escaped-escape.toml" }
    , { raw = "\"|\\\\.\"", want = "|\\.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\b.\"", want = "|\u{0008}.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\r.\"", want = "|\r.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\u007F.\"", want = "|\u{007f}.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\f.\"", want = "|\u{000c}.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\n.\"", want = "|\n.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\\\u.\"", want = "|\\u.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\u005Cu.\"", want = "|\\u.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\\\u0075.\"", want = "|\\u0075.", file = "valid/string/escapes.toml" }
    , { raw = "\"|\\\\\\u0075.\"", want = "|\\u.", file = "valid/string/escapes.toml" }
