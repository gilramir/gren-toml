module Main exposing (main)

{-| The test suite.

  - `Numbers` is every integer and float in the official TOML test suite, the
    ones that must parse and the ones that must not.

Run with `./run.sh`.

-}

import Node
import Numbers exposing (numbersSuite)
import Test.Runner.UnitNode as U


main : Node.SimpleProgram a
main =
    U.run
        { name = "gren-toml"
        , version = "1.0.0"
        , suites = [ numbersSuite ]
        }
