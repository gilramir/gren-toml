module Main exposing (main)

{-| The `toml-test` interfaces for `gren-toml`, both directions.

    gren-toml-test decode   # TOML on stdin, tagged JSON on stdout
    gren-toml-test encode   # tagged JSON on stdin, TOML on stdout

Either way the contract is the same shape: read all of stdin, write the
converted form to stdout and exit 0, or write something to stderr and exit
non-zero. `build.sh` wraps each subcommand in a script of its own, since what
`toml-test` wants handed to `-decoder` and `-encoder` is a path it can execute.

These programs are plumbing. Everything they could get wrong about TOML is in
`gren-toml`, and everything they could get wrong about the JSON is in
`TaggedJson` and `FromTaggedJson`.

What is genuinely their own business is reading stdin as **bytes** rather than
as text, and reading all of it before decoding any. Nine of the suite's invalid
files are invalid precisely because they are not UTF-8, so a decoder that reads
a string has already lost them; and a character whose bytes straddle a chunk
boundary would look like an encoding error to an incremental decode.

-}

import Argparse.Parser as AP
import Argparse.PrettyPrinter as PP
import Argparse.Program as Program
import Array exposing (Array)
import Bytes exposing (Bytes)
import FromTaggedJson
import Node
import Result exposing (Result(..))
import Stream
import TaggedJson
import Task exposing (Task)
import Toml
import Toml.Encode as Encode
import Toml.Table as Table


type Cmd
    = Decode
    | Encode


parser : AP.App Cmd
parser =
    { name = "gren-toml-test"
    , version = "1.0.0"
    , commands =
        AP.defineGroup
            |> AP.withCommand
                { word = "decode"
                , arguments = AP.noArgs
                , flags = AP.noFlags
                , commonDescription = Just "TOML in, toml-test's tagged JSON out."
                , summary = "Read TOML on stdin and write the tagged JSON description on stdout."
                , example = PP.words "gren-toml-test decode < some.toml"
                , builder = \_ _ -> Decode
                }
            |> AP.withCommand
                { word = "encode"
                , arguments = AP.noArgs
                , flags = AP.noFlags
                , commonDescription = Just "toml-test's tagged JSON in, TOML out."
                , summary = "Read the tagged JSON on stdin and write TOML on stdout."
                , example = PP.words "gren-toml-test encode < some.json"
                , builder = \_ _ -> Encode
                }
    , intro = PP.words "The toml-test decoder and encoder interfaces for gren-toml."
    , outro = PP.empty
    }


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\environment ->
                Program.run environment
                    { parser = parser
                    , onCommand =
                        \env command ->
                            when command is
                                Decode ->
                                    convert env decodeToml

                                Encode ->
                                    convert env encodeToml
                    }
            )


{-| Both subcommands are the same program with a different function in the
middle: all of stdin, through a conversion that may fail, out to stdout.

The conversion produces the exact bytes to write, trailing newline included, so
that neither direction ends up with one more or one fewer than it meant to.

-}
convert : Node.Environment -> (Bytes -> Result String String) -> Task Program.Failure {}
convert env change =
    readAll env.stdin
        |> Task.andThen
            (\source ->
                when change source is
                    Err message ->
                        Task.fail (Program.ExitMessage message)

                    Ok written ->
                        Stream.writeStringAsBytes written env.stdout
                            |> Task.map (\_ -> {})
                            |> Task.onError
                                (\error ->
                                    Task.fail
                                        (Program.ExitMessage (Stream.errorToString error))
                                )
            )


decodeToml : Bytes -> Result String String
decodeToml source =
    when Toml.parseBytes source is
        Err error ->
            Err (Toml.errorToString error)

        Ok document ->
            when Table.fromDocument document is
                Err error ->
                    Err (Table.errorToString error)

                Ok table ->
                    Ok (TaggedJson.encode table ++ "\n")


{-| JSON is text by definition, so this direction may decode first and ask
questions after -- unlike the other one, where whether the bytes are UTF-8 at all
is part of what is being tested.
-}
encodeToml : Bytes -> Result String String
encodeToml source =
    when Bytes.toString source is
        Nothing ->
            Err "the input is not valid UTF-8"

        Just text ->
            FromTaggedJson.decode text
                |> Result.map Encode.toString


{-| Every byte of stdin, in one `Bytes`.
-}
readAll : Stream.Readable Bytes -> Task Program.Failure Bytes
readAll stdin =
    Stream.readUntilClosed
        (\chunk chunks -> Ok (Array.pushLast chunk chunks))
        []
        stdin
        |> Task.map Bytes.flatten
        |> Task.onError
            (\error -> Task.fail (Program.ExitMessage (Stream.errorToString error)))
