module Toml exposing
    ( Document
    , Error
    , empty
    , errorToString
    , parse
    , parseBytes
    , toBytes
    , toString
    )

{-| Reading and writing TOML without losing anything on the way through.

    Toml.parseBytes source
        |> Result.map Toml.toString
    --> Ok (the same bytes back)

That round trip is exact for a document nobody has edited, and it is exact
because of how the AST is shaped rather than because of any effort here: the
whitespace, the comments and the source spelling of every number are all in it.
See [`Toml.Ast`](Toml-Ast).


## Which module you want

Take the example from <https://toml.io>:

    [owner]
    name = "Tom Preston-Werner"
    dob = 1979-05-27T07:32:00-08:00

    [database]
    enabled = true
    ports = [ 8000, 8001, 8002 ]
    data = [ ["delta", "phi"], [3.14] ]
    temp_targets = { cpu = 79.5, case = 72.0 }

    [servers]

    [servers.alpha]
    ip = "10.0.0.1"
    role = "frontend"

    [servers.beta]
    ip = "10.0.0.2"
    role = "backend"

`parseBytes` turns it into a `Document`, and every module below works on that or
on something made from it. Each one has this same file read through in its own
docs:

  - **Read it into your own types** -- [`Toml.Decode`](Toml-Decode).

        Toml.Decode.fromBytes
            (Toml.Decode.at [ "servers", "alpha", "ip" ] Toml.Decode.string)
            source
        --> Ok "10.0.0.1"

  - **Change one thing and write it back** -- [`Toml.Edit`](Toml-Edit).

        Toml.parseBytes source
            |> Result.map (Toml.Edit.set [ "database", "enabled" ] (Toml.Edit.bool False))
            |> Result.map Toml.toString

  - **Build a file like it from nothing** -- [`Toml.Encode`](Toml-Encode).
  - **Walk what the file says**, when the keys are the data and no decoder can
    be written ahead of time -- [`Toml.Table`](Toml-Table).
  - **Walk what the file is**, character by character --
    [`Toml.Ast`](Toml-Ast).

@docs Document


## Reading

@docs parse, parseBytes, empty


## Writing

@docs toString, toBytes


## Errors

@docs Error, errorToString

-}

import Array
import Basics exposing (..)
import Bytes exposing (Bytes)
import Bytes.Decode
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import String.Parser.Advanced as P
import Toml.Ast as Ast
import Toml.Parse as Parse
import Toml.Write as Write


{-| A parsed TOML file. See [`Toml.Ast.Document`](Toml-Ast#Document) for what is
in one.
-}
type alias Document =
    Ast.Document


{-| A document with nothing in it.

This exists for one situation, and it is the situation a program that keeps a
config file is in every time it saves: **the file may not be there yet.**

    when found is
        Nothing ->
            -- No file. The first run.
            Ok Toml.empty

        Just bytes ->
            Toml.parseBytes bytes

    |> Result.map (Toml.Edit.set [ "theme" ] (Toml.Edit.string "dark"))

With it, creating the file and changing one value in it are the same code --
[`Toml.Edit.set`](Toml-Edit#set) adds a key that is not there, and every key is
missing from an empty document. Without it a program needs a second path that
writes the file from scratch, which is a second place to keep the shape of the
file and the first place for the two to drift apart.

**A file that is there and will not parse is not this.** It is tempting to write
`Toml.parseBytes bytes |> Result.withDefault Toml.empty` and be done with both
cases at once, and it is the one thing not to write: a config file with a typo
in it would parse to `Err`, become the empty document, and be written back over
the user's file, comments and all, on the next save. `empty` is for a file that
does not exist. A file that exists and cannot be read is an error to show the
user, and the save has to not happen.

`Toml.toString empty` is `""`, and a value set into it lands on line one with
no leading blank.

-}
empty : Document
empty =
    { hasBom = False
    , expressions = [ { indent = "", content = Ast.Empty { comment = Nothing }, newline = Nothing } ]
    }


{-| Read a TOML file from its bytes.

**This is the one to use.** It is the only entry point that can tell a valid
file from an invalid one, because two of the things that make a TOML file
invalid are decided before there is a `String` to look at:

  - **The encoding.** `Bytes.toString` is a strict UTF-8 decode, so a file with
    a bad byte sequence in it -- or a UTF-16 file, or a lone surrogate -- is
    refused here. By the time a caller holds a `String`, any such error has
    already been repaired into `U+FFFD`, and `U+FFFD` is a legal TOML character,
    so it cannot be found again afterwards.
  - **The byte order mark.** Exactly one leading mark is allowed and is not part
    of the document. This function looks at the first three bytes itself, takes
    the mark off the decoded text, and records what it saw, which is what lets
    [`toString`](#toString) put it back.

-}
parseBytes : Bytes -> Result Error Document
parseBytes bytes =
    when Bytes.toString bytes is
        Nothing ->
            Err { row = 1, col = 1, expecting = "valid UTF-8" }

        Just text ->
            -- Geng's decode keeps every character, a leading U+FEFF included;
            -- stock Gren's removed one as a byte order mark (gren-lang/core#155).
            -- So the mark the bytes had comes off here, and one that is still
            -- there is a second one, which the grammar is right to refuse.
            if startsWithBom bytes then
                parseDecoded (String.dropFirst 1 text)
                    |> Result.map (\doc -> { doc | hasBom = True })

            else
                parseDecoded text


{-| Read a TOML file from a string.

Offered for convenience and for callers who already have the text. It cannot
detect an encoding error, by construction -- see [`parseBytes`](#parseBytes).

A byte order mark it can still see. Not every way of reading a file as text
removes one, so if the string begins with `U+FEFF` that is taken to be the
file's mark, dropped, and recorded so that [`toString`](#toString) puts it
back. If something removed it before the text got here, the document is
recorded as having none, since whatever removed it did not say.

-}
parse : String -> Result Error Document
parse text =
    if String.startsWith "\u{FEFF}" text then
        parseDecoded (String.dropFirst 1 text)
            |> Result.map (\doc -> { doc | hasBom = True })

    else
        parseDecoded text


{-| Parse text that has had its byte order mark, if any, taken off already.
-}
parseDecoded : String -> Result Error Document
parseDecoded text =
    when P.run Parse.document {} text is
        Ok doc ->
            Ok doc

        Err deadEnds ->
            Err (chooseError deadEnds)


{-| Write a document back out.
-}
toString : Document -> String
toString =
    Write.document


{-| Write a document back out as bytes, which is the way back from
[`parseBytes`](#parseBytes).

The byte order mark comes with it if the source had one. `toString` puts the
mark back too -- it is a character in the string it returns -- so this is
`Bytes.fromString` after it and is offered only so that reading and writing a
file are the same shape.

-}
toBytes : Document -> Bytes
toBytes document =
    Bytes.fromString (toString document)


{-| Where the parser stopped and what it wanted there.
-}
type alias Error =
    { row : Int
    , col : Int
    , expecting : String
    }


{-| An error as a line of text.

    "line 4, column 9: expected an '=' after the key"

-}
errorToString : Error -> String
errorToString error =
    "line "
        ++ String.fromInt error.row
        ++ ", column "
        ++ String.fromInt error.col
        ++ ": expected "
        ++ error.expecting


{-| The one dead end worth reporting.

The parser hands back every alternative that failed where it stopped, and the
first of them is usually the least helpful: for `a = @` it is the opening quote
of a string, because strings are tried first. The furthest position wins, and at
that position the problem [`Toml.Parse.rank`](Toml-Parse#rank) puts highest --
"a value" over the eight ways of starting one.

-}
chooseError : Array (P.DeadEnd {} Parse.Problem) -> Error
chooseError deadEnds =
    let
        better candidate best =
            if candidate.row /= best.row then
                candidate.row > best.row

            else if candidate.col /= best.col then
                candidate.col > best.col

            else
                Parse.rank candidate.problem > Parse.rank best.problem

        prefer candidate best =
            if better candidate best then
                candidate

            else
                best
    in
    when Array.popFirst deadEnds is
        Just { first, rest } ->
            let
                chosen =
                    Array.foldl prefer first rest
            in
            { row = chosen.row
            , col = chosen.col
            , expecting = Parse.problemToString chosen.problem
            }

        Nothing ->
            { row = 1, col = 1, expecting = "a TOML document" }


{-| Whether the first three bytes are a UTF-8 byte order mark.

This is asked of the bytes, because that is where a mark is a mark: a
`String` beginning with U+FEFF could have been written that way.

-}
startsWithBom : Bytes -> Bool
startsWithBom bytes =
    Bytes.Decode.decode
        (Bytes.Decode.map3
            (\a b c -> a == 0xEF && b == 0xBB && c == 0xBF)
            Bytes.Decode.unsignedInt8
            Bytes.Decode.unsignedInt8
            Bytes.Decode.unsignedInt8
        )
        bytes
        |> Maybe.withDefault False
