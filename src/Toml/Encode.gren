@docs array, table, inlineTable, tableArray

-}

import Array exposing (Array)
import Basics exposing (..)
import BigDecimal exposing (BigDecimal)
import BigInt exposing (BigInt)
import Civil.Date exposing (Date)
import Civil.DateTime exposing (DateTime)
import Civil.Time exposing (Time)
import Maybe exposing (Maybe(..))
import String
import Toml.Ast as Ast exposing
    ( Content(..)
    , Document
    , Expression
    , Newline(..)
    , TableKind(..)
    )
import Toml.Literal as Literal
import Toml.Write as Write


{-| A value on its way into a file.
-}
type Value
    = Scalar Ast.Value
    | Section (Array Field)
    | Sections (Array (Array Field))


{-| A key, the value under it, and the comments that explain it.

Build one with [`field`](#field) and, if it needs explaining,
[`commented`](#commented). The record is open so that it can be read apart;
constructing one by hand works too and only saves a function call.

-}
type alias Field =
    { key : String
    , value : Value
    , comments : Comments
    }


{-| Comments on a field: a block of whole lines above it, and one after the
value on the same line.

Each string is the text *after* the `#`, the leading space included, because
`# note` and `#note` are different files and neither is this module's to choose.

There is no blank-line field here, unlike
[`Toml.Edit.Comments`](Toml-Edit#Comments), for the reason the whole of [the
style](#the-style) gives: a file this module wrote has no author to have an
opinion about its spacing, so the spacing is decided here. A commented field
gets a blank line above it.

-}
type alias Comments =
    { leading : Array String
    , trailing : Maybe String
    }


{-| A key and the value under it.

    Toml.Encode.field "port" (Toml.Encode.int 8080)

-}
field : String -> Value -> Field
field key content =
    { key = key, value = content, comments = { leading = [], trailing = Nothing } }


{-| Explain a field.

    Toml.Encode.toString
        [ Toml.Encode.field "a" (Toml.Encode.int 1)
        , Toml.Encode.field "port" (Toml.Encode.int 8080)
            |> Toml.Encode.commented
                { leading = [ " What to listen on." ], trailing = Just " http" }
        ]

    -->  a = 1
    -->
    -->  # What to listen on.
    -->  port = 8080 # http

The blank line above the block is [the style](#the-style) rather than a choice,
and it is not written at the top of a file or under a `[header]`, where there
would be nothing above it to separate it from.

A file nobody can read is not much better than no file, and comments are the
reason to reach for a TOML library that keeps them rather than one that does
not. This is that reason applied to the direction that writes a file instead of
reading one.

**On a field whose value is a [`table`](#table) or a
[`tableArray`](#tableArray)**, the comments go with the `[header]` line, since
that is the line the field became. On a `tableArray` they go with the first
`[[header]]` only, the block above it and the trailing comment beside it -- they
explain the key, and repeating them over every item would explain nothing.

**On a field inside an [`array`](#array) or an
[`inlineTable`](#inlineTable)** they are dropped, because there is no line for
them to be on. That is the same boundary
[`Toml.Edit`](Toml-Edit#what-a-path-means-here) draws at a brace and for the
same reason: what is inside one is written on one line, and a comment runs to
the end of a line.

-}
commented : Comments -> Field -> Field
commented note it =
    { it | comments = note }


-- WRITING IT OUT


{-| The fields as a document, which [`Toml.toString`](Toml#toString) will write
and which [`Toml.Edit`](Toml-Edit) can go on changing.
-}
toDocument : Array Field -> Document
toDocument fields =
    { hasBom = False
    , expressions = Array.pushLast endOfFile (tidyBlanks (section [] fields))
    }


{-| Take out the blank lines that ask to separate something from nothing.

Two things put a blank line into the output and neither can see what is around
it: a `[header]` gets one to hold it off what is above, and so does a commented
field. That is right in the middle of a file and wrong at two of its edges, so
rather than teach both of them where they are, the blanks go in unconditionally
and the ones with nothing to separate come out again here:

  - **At the top of the file**, where there is nothing above to be held off.
  - **Between a `[header]` and the first key of its own table**, where a blank
    would push the key away from the header it belongs to. Not between a header
    and a *nested* header, which is two sections meeting and wants the space --
    which is why this looks at what follows the blank as well as at what
    precedes it, and looks past a comment block to do it, since a nested header
    with an explanation over it is still a nested header.

-}
tidyBlanks : Array Expression -> Array Expression
tidyBlanks expressions =
    Array.indexedMap
        (\index expression ->
            if isPlainBlank expression && not (separatesAnything index expressions) then
                Nothing

            else
                Just expression
        )
        expressions
        |> Array.mapAndKeepJust identity


{-| Whether the blank line at `index` has something on both sides of it that
wants to be kept apart.

The `index <= 0` guard is not defensive. `Array.get -1` in Gren is the *last*
element, so without it the first line of the file would be asked whether the
last one wants a blank after it, and the answer would usually be yes.

-}
separatesAnything : Int -> Array Expression -> Bool
separatesAnything index expressions =
    when
        (if index <= 0 then
            Nothing

         else
            Array.get (index - 1) expressions
        )
    is
        Nothing ->
            False

        Just previous ->
            when previous.content is
                Header _ ->
                    when Maybe.map .content (afterCommentBlock (index + 1) expressions) is
                        Just (Header _) ->
                            True

                        _ ->
                            False

                _ ->
                    not (isPlainBlank previous)


{-| The first expression at or after `index` that is not an own-line comment.

A nested header with a comment block over it is still a nested header, and the
blank that separates it from the header above is still wanted. Looking only at
the line after the blank would see the comment and take the blank out.

-}
afterCommentBlock : Int -> Array Expression -> Maybe Expression
afterCommentBlock index expressions =
    when Array.get index expressions is
        Just expression ->
            when expression.content is
                Empty { comment } ->
                    if comment == Nothing then
                        Just expression

                    else
                        afterCommentBlock (index + 1) expressions

                _ ->
                    Just expression

        Nothing ->
            Nothing


isPlainBlank : Expression -> Bool
isPlainBlank expression =
    when expression.content is
        Empty fields ->
            fields.comment == Nothing

        _ ->
            False


{-| The fields as text.
-}
toString : Array Field -> String
toString fields =
    Write.document (toDocument fields)


{-| The expression a file ends with: nothing, on a line of its own, after the
last newline. This is what the parser produces for a file that ends with a
newline, and producing it here is what makes one.
-}
endOfFile : Expression
endOfFile =
    { indent = "", content = Empty { comment = Nothing }, newline = Nothing }


line : Content -> Expression
line content =
    { indent = "", content = content, newline = Just Lf }


blank : Expression
blank =
    line (Empty { comment = Nothing })


-- THE SHAPE OF THE OUTPUT


{-| One table's worth of lines: its own keys, and then its sub-tables.

The order matters and is not a preference. A key written after a `[header]`
belongs to that header's table, so every key of *this* table has to come first
or it silently ends up somewhere else.

-}
section : Array String -> Array Field -> Array Expression
section path fields =
    let
        leaves =
            Array.keepIf (\it -> not (isSection it.value)) fields

        nested =
            Array.keepIf (\it -> isSection it.value) fields
    in
    Array.prepend
        (Array.mapAndFlatten (keyLine path) leaves)
        (Array.mapAndFlatten (header path) nested)


{-| Whether a value is written as `[header]` lines rather than beside its key.

An *empty* array of tables is not: there would be no headers to write, and the
key would vanish from the file. It is written as `key = []` instead, which a
reader cannot tell from an empty array of tables and which keeps the key.

-}
isSection : Value -> Bool
isSection content =
    when content is
        Scalar _ ->
            False

        Section _ ->
            True

        Sections items ->
            Array.length items > 0


{-| One `key = value` line, with its comment block above it and its own comment
after it.

An array rather than an expression because the comment block is lines of the
file too, and the blank line that goes above a commented field is one more --
`tidyBlanks` takes that one out again if there is nothing above to separate it
from.

-}
keyLine : Array String -> Field -> Array Expression
keyLine _ it =
    Array.pushLast
        (line
            (Pair
                { keyval =
                    { key = Literal.key [ it.key ]
                    , wsBeforeEq = " "
                    , wsAfterEq = " "
                    , value = flatten it.value
                    }
                , trailing = trailingSpace it.comments.trailing
                , comment = Maybe.map (\text -> { text = text }) it.comments.trailing
                }
            )
        )
        (block it.comments.leading)


{-| What goes above a `[header]`: the blank line that holds it off what came
before, and the comment block if it has one -- which brings its own blank line,
so there is exactly one either way.
-}
opening : Array String -> Array Expression
opening leading =
    if Array.length leading == 0 then
        [ blank ]

    else
        block leading


{-| The comment block above a line, with the blank line that separates it from
whatever is above. Nothing at all when there are no comments.
-}
block : Array String -> Array Expression
block leading =
    if Array.length leading == 0 then
        []

    else
        Array.prepend
            [ blank ]
            (Array.map (\text -> line (Empty { comment = Just { text = text } })) leading)


{-| `x = 1# note` is legal TOML and nobody writes it.
-}
trailingSpace : Maybe String -> String
trailingSpace comment =
    when comment is
        Just _ ->
            " "

        Nothing ->
            ""


{-| A `[header]` section, or a `[[header]]` for every item of a table array.
-}
header : Array String -> Field -> Array Expression
header path it =
    let
        here =
            Array.pushLast it.key path
    in
    when it.value is
        Section fields ->
            Array.prepend
                (Array.prepend
                    (opening it.comments.leading)
                    [ line (headerLine Std here it.comments.trailing) ]
                )
                (section here fields)

        Sections items ->
            Array.indexedMap
                (\index fields ->
                    Array.prepend
                        -- The comments explain the key, so they go over the
                        -- first item alone. Repeated above every `[[header]]`
                        -- they would explain nothing and be four copies of one
                        -- sentence to keep in step.
                        (if index == 0 then
                            opening it.comments.leading

                         else
                            [ blank ]
                        )
                        (Array.prepend
                            [ line
                                (headerLine ArrayOfTables
                                    here
                                    (if index == 0 then
                                        it.comments.trailing

                                     else
                                        Nothing
                                    )
                                )
                            ]
                            (section here fields)
                        )
                )
                items
                |> Array.flatten

        Scalar _ ->
            []


headerLine : TableKind -> Array String -> Maybe String -> Content
headerLine kind path comment =
    Header
        { header =
            { kind = kind
            , wsBefore = ""
            , key = Literal.key path
            , wsAfter = ""
            }
        , trailing = trailingSpace comment
        , comment = Maybe.map (\text -> { text = text }) comment
        }


{-| A value written in one line, for the places a header is not available:
inside an array, and inside another inline table.
-}
flatten : Value -> Ast.Value
flatten content =
    when content is
        Scalar found ->
            found

        Section fields ->
            braces fields

        Sections items ->
            brackets (Array.map braces items)


-- SCALARS


{-| A string.
-}
string : String -> Value
string text =
    Scalar (Literal.string text)


{-| An integer that fits in a Gren `Int`.
-}
int : Int -> Value
int number =
    Scalar (Literal.int number)


{-| An integer of any size.
-}
bigInt : BigInt -> Value
bigInt number =
    Scalar (Literal.bigInt number)


{-| A float. `inf` and `nan` are written as those words; everything else gets a
decimal point even when it does not need one, since `1` without one is an
integer in TOML.
-}
float : Float -> Value
float number =
    Scalar (Literal.float number)


{-| An exact decimal.
-}
bigDecimal : BigDecimal -> Value
bigDecimal number =
    Scalar (Literal.bigDecimal number)


{-| A boolean.
-}
bool : Bool -> Value
bool flag =
    Scalar (Literal.bool flag)


{-| A date and time with an offset.
-}
offsetDateTime : DateTime -> Value
offsetDateTime moment =
    Scalar (Literal.offsetDateTime moment)


{-| A date and time with no offset.
-}
localDateTime : DateTime -> Value
localDateTime moment =
    Scalar (Literal.localDateTime moment)


{-| A date.
-}
localDate : Date -> Value
localDate day =
    Scalar (Literal.localDate day)


{-| A time of day.
-}
localTime : Time -> Value
localTime clock =
    Scalar (Literal.localTime clock)


-- STRUCTURES


{-| An array, on one line: `[1, 2, 3]`.

Tables inside it are written inline, since there is no header to give them.

-}
array : Array Value -> Value
array items =
    Scalar (brackets (Array.map flatten items))


{-| A table written as a `[header]` section.

    Toml.Encode.table [ Toml.Encode.field "port" (Toml.Encode.int 80) ]

    -->  [server]
    -->  port = 80

Except inside an array, where there is no header to be had and it comes out as
`{ port = 80 }`.

-}
table : Array Field -> Value
table fields =
    Section fields


{-| A table written on one line: `{ port = 80 }`.
-}
inlineTable : Array Field -> Value
inlineTable fields =
    Scalar (braces fields)


{-| An array of tables, written as a `[[header]]` for each.

    Toml.Encode.tableArray
        [ [ Toml.Encode.field "name" (Toml.Encode.string "alpha") ]
        , [ Toml.Encode.field "name" (Toml.Encode.string "beta") ]
        ]

    -->  [[peer]]
    -->  name = "alpha"
    -->
    -->  [[peer]]
    -->  name = "beta"

An empty one has no headers to write, so it is written as `peer = []` rather
than not at all. A reader cannot tell the two apart, and a key must not vanish
from a file because its array happened to be empty.

-}
tableArray : Array (Array Field) -> Value
tableArray items =
    Sections items


-- THE ONE-LINE FORMS


{-| `[a, b, c]`, with a space after each comma and none inside the brackets.
-}
brackets : Array Ast.Value -> Ast.Value
brackets =
    Literal.array


{-| `{ a = 1, b = 2 }`, with a space inside each brace. `{}` when empty, since a
space inside an empty one would be an odd thing to write.

The fields are flattened on the way, since inside a brace there is no header to
give a table and it has to be written inline whatever it was built with.

-}
braces : Array Field -> Ast.Value
braces fields =
    Literal.inlineTable
        (Array.map (\it -> { key = it.key, value = flatten it.value }) fields)
