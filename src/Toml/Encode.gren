module Toml.Encode exposing
    ( Value, Field, field
    , toDocument, toString
    , string, int, bigInt, float, bigDecimal, bool
    , offsetDateTime, localDateTime, localDate, localTime
    , array, table, inlineTable, tableArray
    )

{-| Writing a TOML file from scratch.

    Toml.Encode.toString
        [ Toml.Encode.field "name" (Toml.Encode.string "widget")
        , Toml.Encode.field "server"
            (Toml.Encode.table
                [ Toml.Encode.field "host" (Toml.Encode.string "example.com")
                , Toml.Encode.field "port" (Toml.Encode.int 8080)
                ]
            )
        ]

    -->  name = "widget"
    -->
    -->  [server]
    -->  host = "example.com"
    -->  port = 8080

This is the other direction from [`Toml.Decode`](Toml-Decode), and the other
half of [`Toml.Edit`](Toml-Edit): editing is for a file that exists, and this is
for one that does not.


## You choose the shape, not a heuristic

A TOML table can be written as a `[header]` section or as `{ inline = "table" }`,
and an array of tables as `[[header]]` sections or as an array of inline ones.
Both spellings mean the same thing, so a library has to either guess or ask.
This one asks: [`table`](#table) and [`tableArray`](#tableArray) produce
headers, [`inlineTable`](#inlineTable) and [`array`](#array) produce braces and
brackets. The only place the choice is taken away is inside an array, where a
header is not available and a table is written inline whatever it was built
with.

Fields come out in the order you give them, because you chose it. Within a
table, though, the scalars are written before the sections, since a key written
after a `[header]` would land inside that header's table rather than beside it.


## The style

One space either side of the equals sign, one blank line before each header
except the first, no indentation, `\\n` line endings, and a final newline. There
is no way to change any of that, on the grounds that a file this produced has no
author to have an opinion -- and the moment one does, the file should be read and
*edited* rather than regenerated, which is what the rest of this package is for.


## A whole file

The example from <https://toml.io>, built from nothing. The nesting of the
fields is the nesting of the file, and `table` at each level is what asks for a
`[header]` rather than braces:

    Toml.Encode.toString
        [ Toml.Encode.field "owner"
            (Toml.Encode.table
                [ Toml.Encode.field "name" (Toml.Encode.string "Tom Preston-Werner")
                , Toml.Encode.field "dob" (Toml.Encode.offsetDateTime dob)
                ]
            )
        , Toml.Encode.field "database"
            (Toml.Encode.table
                [ Toml.Encode.field "enabled" (Toml.Encode.bool True)
                , Toml.Encode.field "ports"
                    (Toml.Encode.array
                        [ Toml.Encode.int 8000, Toml.Encode.int 8001, Toml.Encode.int 8002 ]
                    )
                , Toml.Encode.field "data"
                    (Toml.Encode.array
                        [ Toml.Encode.array
                            [ Toml.Encode.string "delta", Toml.Encode.string "phi" ]
                        , Toml.Encode.array [ Toml.Encode.float 3.14 ]
                        ]
                    )
                , Toml.Encode.field "temp_targets"
                    (Toml.Encode.inlineTable
                        [ Toml.Encode.field "cpu" (Toml.Encode.float 79.5)
                        , Toml.Encode.field "case" (Toml.Encode.float 72.0)
                        ]
                    )
                ]
            )
        , Toml.Encode.field "servers"
            (Toml.Encode.table
                [ Toml.Encode.field "alpha"
                    (Toml.Encode.table
                        [ Toml.Encode.field "ip" (Toml.Encode.string "10.0.0.1")
                        , Toml.Encode.field "role" (Toml.Encode.string "frontend")
                        ]
                    )
                , Toml.Encode.field "beta"
                    (Toml.Encode.table
                        [ Toml.Encode.field "ip" (Toml.Encode.string "10.0.0.2")
                        , Toml.Encode.field "role" (Toml.Encode.string "backend")
                        ]
                    )
                ]
            )
        ]

where `dob` is `Civil.DateTime.fromString "1979-05-27T07:32:00-08:00"`, unwrapped
from its `Maybe`. That writes:

    [owner]
    name = "Tom Preston-Werner"
    dob = 1979-05-27T07:32:00-08:00

    [database]
    enabled = true
    ports = [8000, 8001, 8002]
    data = [["delta", "phi"], [3.14]]
    temp_targets = { cpu = 79.5, case = 72.0 }

    [servers]

    [servers.alpha]
    ip = "10.0.0.1"
    role = "frontend"

    [servers.beta]
    ip = "10.0.0.2"
    role = "backend"

which is the original file except that the original had a space inside each
bracket -- `[ 8000, 8001, 8002 ]` -- and this writes none. That difference is the
whole distinction between this module and [`Toml.Edit`](Toml-Edit). The spaces
belonged to whoever wrote the file, and a file built from nothing has nobody to
have written them.

Two things in that example are worth pointing at:

  - `[servers]` comes out on a line of its own with nothing under it, because
    `servers` has no keys of its own and two sub-tables. That is what the nesting
    said, and it is a legal and ordinary TOML file.
  - `temp_targets` uses [`inlineTable`](#inlineTable) rather than
    [`table`](#table), which is the only reason it comes out in braces. Swap the
    two and it becomes a `[database.temp_targets]` section instead. Nothing here
    guesses.

@docs Value, Field, field


## Writing it out

@docs toDocument, toString


## Scalars

@docs string, int, bigInt, float, bigDecimal, bool
@docs offsetDateTime, localDateTime, localDate, localTime


## Structures

@docs array, table, inlineTable, tableArray

-}

import Array exposing (Array)
import Basics exposing (..)
import BigDecimal exposing (BigDecimal)
import BigInt exposing (BigInt)
import Civil.Date exposing (Date)
import Civil.DateTime exposing (DateTime)
import Civil.Time exposing (Time)
import Maybe exposing (Maybe(..))
import String
import Toml.Ast as Ast
    exposing
        ( Content(..)
        , Document
        , Expression
        , Newline(..)
        , TableKind(..)
        )
import Toml.Literal as Literal
import Toml.Write as Write


{-| A value on its way into a file.
-}
type Value
    = Scalar Ast.Value
    | Section (Array Field)
    | Sections (Array (Array Field))


{-| A key and the value under it.
-}
type alias Field =
    { key : String
    , value : Value
    }


{-| A key and the value under it.

    Toml.Encode.field "port" (Toml.Encode.int 8080)

-}
field : String -> Value -> Field
field key content =
    { key = key, value = content }



-- WRITING IT OUT


{-| The fields as a document, which [`Toml.toString`](Toml#toString) will write
and which [`Toml.Edit`](Toml-Edit) can go on changing.
-}
toDocument : Array Field -> Document
toDocument fields =
    { hasBom = False
    , expressions = Array.pushLast endOfFile (withoutLeadingBlank (section [] fields))
    }


{-| The blank line before a `[header]` separates it from what came above. At the
top of the file there is nothing above it, and a file that opens with an empty
line is not what anyone asked for.
-}
withoutLeadingBlank : Array Expression -> Array Expression
withoutLeadingBlank expressions =
    when Array.first expressions is
        Just first ->
            when first.content is
                Empty fields ->
                    if fields.comment == Nothing then
                        Array.dropFirst 1 expressions

                    else
                        expressions

                _ ->
                    expressions

        Nothing ->
            expressions


{-| The fields as text.
-}
toString : Array Field -> String
toString fields =
    Write.document (toDocument fields)


{-| The expression a file ends with: nothing, on a line of its own, after the
last newline. This is what the parser produces for a file that ends with a
newline, and producing it here is what makes one.
-}
endOfFile : Expression
endOfFile =
    { indent = "", content = Empty { comment = Nothing }, newline = Nothing }


line : Content -> Expression
line content =
    { indent = "", content = content, newline = Just Lf }


blank : Expression
blank =
    line (Empty { comment = Nothing })



-- THE SHAPE OF THE OUTPUT


{-| One table's worth of lines: its own keys, and then its sub-tables.

The order matters and is not a preference. A key written after a `[header]`
belongs to that header's table, so every key of *this* table has to come first
or it silently ends up somewhere else.

-}
section : Array String -> Array Field -> Array Expression
section path fields =
    let
        leaves =
            Array.keepIf (\it -> not (isSection it.value)) fields

        nested =
            Array.keepIf (\it -> isSection it.value) fields
    in
    Array.prepend
        (Array.map (keyLine path) leaves)
        (Array.mapAndFlatten (header path) nested)


{-| Whether a value is written as `[header]` lines rather than beside its key.

An *empty* array of tables is not: there would be no headers to write, and the
key would vanish from the file. It is written as `key = []` instead, which a
reader cannot tell from an empty array of tables and which keeps the key.

-}
isSection : Value -> Bool
isSection content =
    when content is
        Scalar _ ->
            False

        Section _ ->
            True

        Sections items ->
            Array.length items > 0


keyLine : Array String -> Field -> Expression
keyLine _ it =
    line
        (Pair
            { keyval =
                { key = Literal.key [ it.key ]
                , wsBeforeEq = " "
                , wsAfterEq = " "
                , value = flatten it.value
                }
            , trailing = ""
            , comment = Nothing
            }
        )


{-| A `[header]` section, or a `[[header]]` for every item of a table array.
-}
header : Array String -> Field -> Array Expression
header path it =
    let
        here =
            Array.pushLast it.key path
    in
    when it.value is
        Section fields ->
            Array.prepend
                [ blank, line (headerLine Std here) ]
                (section here fields)

        Sections items ->
            Array.mapAndFlatten
                (\fields ->
                    Array.prepend
                        [ blank, line (headerLine ArrayOfTables here) ]
                        (section here fields)
                )
                items

        Scalar _ ->
            []


headerLine : TableKind -> Array String -> Content
headerLine kind path =
    Header
        { header =
            { kind = kind
            , wsBefore = ""
            , key = Literal.key path
            , wsAfter = ""
            }
        , trailing = ""
        , comment = Nothing
        }


{-| A value written in one line, for the places a header is not available:
inside an array, and inside another inline table.
-}
flatten : Value -> Ast.Value
flatten content =
    when content is
        Scalar found ->
            found

        Section fields ->
            braces fields

        Sections items ->
            brackets (Array.map braces items)



-- SCALARS


{-| A string.
-}
string : String -> Value
string text =
    Scalar (Literal.string text)


{-| An integer that fits in a Gren `Int`.
-}
int : Int -> Value
int number =
    Scalar (Literal.int number)


{-| An integer of any size.
-}
bigInt : BigInt -> Value
bigInt number =
    Scalar (Literal.bigInt number)


{-| A float. `inf` and `nan` are written as those words; everything else gets a
decimal point even when it does not need one, since `1` without one is an
integer in TOML.
-}
float : Float -> Value
float number =
    Scalar (Literal.float number)


{-| An exact decimal.
-}
bigDecimal : BigDecimal -> Value
bigDecimal number =
    Scalar (Literal.bigDecimal number)


{-| A boolean.
-}
bool : Bool -> Value
bool flag =
    Scalar (Literal.bool flag)


{-| A date and time with an offset.
-}
offsetDateTime : DateTime -> Value
offsetDateTime moment =
    Scalar (Literal.offsetDateTime moment)


{-| A date and time with no offset.
-}
localDateTime : DateTime -> Value
localDateTime moment =
    Scalar (Literal.localDateTime moment)


{-| A date.
-}
localDate : Date -> Value
localDate day =
    Scalar (Literal.localDate day)


{-| A time of day.
-}
localTime : Time -> Value
localTime clock =
    Scalar (Literal.localTime clock)



-- STRUCTURES


{-| An array, on one line: `[1, 2, 3]`.

Tables inside it are written inline, since there is no header to give them.

-}
array : Array Value -> Value
array items =
    Scalar (brackets (Array.map flatten items))


{-| A table written as a `[header]` section.

    Toml.Encode.table [ Toml.Encode.field "port" (Toml.Encode.int 80) ]

    -->  [server]
    -->  port = 80

Except inside an array, where there is no header to be had and it comes out as
`{ port = 80 }`.

-}
table : Array Field -> Value
table fields =
    Section fields


{-| A table written on one line: `{ port = 80 }`.
-}
inlineTable : Array Field -> Value
inlineTable fields =
    Scalar (braces fields)


{-| An array of tables, written as a `[[header]]` for each.

    Toml.Encode.tableArray
        [ [ Toml.Encode.field "name" (Toml.Encode.string "alpha") ]
        , [ Toml.Encode.field "name" (Toml.Encode.string "beta") ]
        ]

    -->  [[peer]]
    -->  name = "alpha"
    -->
    -->  [[peer]]
    -->  name = "beta"

An empty one has no headers to write, so it is written as `peer = []` rather
than not at all. A reader cannot tell the two apart, and a key must not vanish
from a file because its array happened to be empty.

-}
tableArray : Array (Array Field) -> Value
tableArray items =
    Sections items



-- THE ONE-LINE FORMS


{-| `[a, b, c]`, with a space after each comma and none inside the brackets.
-}
brackets : Array Ast.Value -> Ast.Value
brackets =
    Literal.array


{-| `{ a = 1, b = 2 }`, with a space inside each brace. `{}` when empty, since a
space inside an empty one would be an odd thing to write.

The fields are flattened on the way, since inside a brace there is no header to
give a table and it has to be written inline whatever it was built with.

-}
braces : Array Field -> Ast.Value
braces fields =
    Literal.inlineTable
        (Array.map (\it -> { key = it.key, value = flatten it.value }) fields)
