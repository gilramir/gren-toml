-}

import Array exposing (Array)
import Basics exposing (..)
import BigDecimal exposing (BigDecimal)
import BigInt exposing (BigInt)
import Bytes exposing (Bytes)
import Civil.Date exposing (Date)
import Civil.DateTime exposing (DateTime)
import Civil.Time exposing (Time)
import Dict exposing (Dict)
import Maybe exposing (Maybe(..))
import Result exposing (Result(..))
import String
import Toml
import Toml.Ast as Ast
import Toml.Table as Table exposing (Table)


{-| Something that knows how to turn a TOML value into an `a`, or say why it
cannot.
-}
type Decoder a
    = Decoder (Table.Value -> Result Error a)


{-| Why a file did not become the value you asked for.

The first two are about the file and the rest are about the shape of what was in
it. `Field` and `Index` wrap the error underneath them, so the whole chain says
where it happened -- which is what [`errorToString`](#errorToString) renders as a
path.

-}
type Error
    = Syntax Toml.Error
    | Semantics Table.Error
    | Field { name : String, inner : Error }
    | Index { at : Int, inner : Error }
    | Expected { wanted : String, found : String }
    | OneOfFailed (Array Error)
    | Custom String


{-| An error as a line of text, with the path to where it happened.

    "at server.ports[2]: expected an integer, found a string"

-}
errorToString : Error -> String
errorToString error =
    let
        { path, message } =
            unwind error ""
    in
    if path == "" then
        message

    else
        "at " ++ path ++ ": " ++ message


unwind : Error -> String -> { path : String, message : String }
unwind error path =
    when error is
        Field fields ->
            unwind fields.inner
                (if path == "" then
                    fields.name

                 else
                    path ++ "." ++ fields.name
                )

        Index fields ->
            unwind fields.inner (path ++ "[" ++ String.fromInt fields.at ++ "]")

        Syntax found ->
            { path = path, message = Toml.errorToString found }

        Semantics found ->
            { path = path, message = Table.errorToString found }

        Expected fields ->
            { path = path
            , message = "expected " ++ fields.wanted ++ ", found " ++ fields.found
            }

        OneOfFailed attempts ->
            { path = path
            , message =
                "none of the "
                    ++ String.fromInt (Array.length attempts)
                    ++ " alternatives matched: "
                    ++ String.join "; " (Array.map errorToString attempts)
            }

        Custom message ->
            { path = path, message = message }


-- RUNNING


{-| Parse, check and decode, in one call. The entry point to reach for.

Bytes rather than a string for the reason [`Toml.parseBytes`](Toml#parseBytes)
gives: an encoding error cannot be found once the bytes are gone.

-}
fromBytes : Decoder a -> Bytes -> Result Error a
fromBytes decoder source =
    Toml.parseBytes source
        |> Result.mapError Syntax
        |> Result.andThen (fromDocument decoder)


{-| The same for text you already have. It cannot detect an encoding error --
see [`Toml.parse`](Toml#parse).
-}
fromString : Decoder a -> String -> Result Error a
fromString decoder source =
    Toml.parse source
        |> Result.mapError Syntax
        |> Result.andThen (fromDocument decoder)


{-| Decode a document that has already been parsed.

For a caller who is holding one because they are also *editing* it -- see
[`Toml.Edit`](Toml-Edit) -- and would rather not parse the file twice. The
document is lowered to a table on the way, which is where a file is rejected for
the things a grammar cannot see, so this can fail with a `Semantics` error that
[`fromTable`](#fromTable) never can.

-}
fromDocument : Decoder a -> Toml.Document -> Result Error a
fromDocument decoder document =
    Table.fromDocument document
        |> Result.mapError Semantics
        |> Result.andThen (fromTable decoder)


{-| Run a decoder against a table you already have.
-}
fromTable : Decoder a -> Table -> Result Error a
fromTable decoder found =
    run decoder (Table.TableValue found)


run : Decoder a -> Table.Value -> Result Error a
run (Decoder decode) content =
    decode content


-- PRIMITIVES


{-| A TOML string.
-}
string : Decoder String
string =
    scalar "a string" <| \content ->
        when content is
            Table.StringValue text ->
                Just text

            _ ->
                Nothing


{-| A TOML boolean.
-}
bool : Decoder Bool
bool =
    scalar "a boolean" <| \content ->
        when content is
            Table.BooleanValue flag ->
                Just flag

            _ ->
                Nothing


{-| A TOML integer, as a Gren `Int`.

Fails when the number is too big for one to hold exactly -- above 2^53, since a
Gren `Int` is a double. That is a refusal rather than a rounding, and it is the
whole reason [`bigInt`](#bigInt) exists.

-}
int : Decoder Int
int =
    Decoder <| \content ->
        when content is
            Table.IntegerValue whole ->
                when BigInt.toInt whole is
                    Just small ->
                        Ok small

                    Nothing ->
                        Err
                            (Custom
                                (BigInt.toString whole
                                    ++ " does not fit in an Int; use bigInt to read it exactly"
                                )
                            )

            _ ->
                Err (Expected { wanted = "an integer", found = describe content })


{-| A TOML integer at its full width, whatever that is.
-}
bigInt : Decoder BigInt
bigInt =
    scalar "an integer" <| \content ->
        when content is
            Table.IntegerValue whole ->
                Just whole

            _ ->
                Nothing


{-| A TOML float, as a Gren `Float`.

`inf` and `nan` come through as the `Float` values of those names. A finite one
is converted from its exact decimal, and *that* conversion is where precision is
lost -- `0.1` in the file is exactly `0.1` until this point. Ask for
[`bigDecimal`](#bigDecimal) to keep it.

-}
float : Decoder Float
float =
    scalar "a float" <| \content ->
        when content is
            Table.FloatValue (Ast.Finite number) ->
                Just (BigDecimal.toFloat number)

            Table.FloatValue (Ast.Infinite Ast.Positive) ->
                Just (1 / 0)

            Table.FloatValue (Ast.Infinite Ast.Negative) ->
                Just (-1 / 0)

            Table.FloatValue (Ast.NotANumber _) ->
                Just (0 / 0)

            _ ->
                Nothing


{-| A finite TOML float as an exact decimal.

`inf` and `nan` are not decimals and fail here; [`float`](#float) is the one
that takes them.

-}
bigDecimal : Decoder BigDecimal
bigDecimal =
    scalar "a finite float" <| \content ->
        when content is
            Table.FloatValue (Ast.Finite number) ->
                Just number

            _ ->
                Nothing


-- DATES AND TIMES


{-| `1979-05-27T07:32:00-08:00`: a date and time that names a moment.
-}
offsetDateTime : Decoder DateTime
offsetDateTime =
    scalar "an offset date-time" <| \content ->
        when content is
            Table.OffsetDateTimeValue moment ->
                Just moment

            _ ->
                Nothing


{-| `1979-05-27T07:32:00`: a date and time that does not.
-}
localDateTime : Decoder DateTime
localDateTime =
    scalar "a local date-time" <| \content ->
        when content is
            Table.LocalDateTimeValue moment ->
                Just moment

            _ ->
                Nothing


{-| `1979-05-27`.
-}
localDate : Decoder Date
localDate =
    scalar "a local date" <| \content ->
        when content is
            Table.LocalDateValue day ->
                Just day

            _ ->
                Nothing


{-| `07:32:00`.
-}
localTime : Decoder Time
localTime =
    scalar "a local time" <| \content ->
        when content is
            Table.LocalTimeValue clock ->
                Just clock

            _ ->
                Nothing


-- STRUCTURES


{-| An array, with every element read the same way.

Both kinds of TOML array are accepted: a `[ ... ]` literal and one built out of
`[[ ... ]]` headers. They are the same array to a reader, and the difference is
only about what may be done to them in the file.

-}
array : Decoder a -> Decoder (Array a)
array element =
    Decoder <| \content ->
        when content is
            Table.ArrayValue items ->
                each element items

            Table.TableArrayValue items ->
                each element (Array.map Table.TableValue items)

            _ ->
                Err (Expected { wanted = "an array", found = describe content })


each : Decoder a -> Array Table.Value -> Result Error (Array a)
each element items =
    Array.indexedFoldl
        (\index item soFar ->
            Result.map2 Array.pushLast
                (run element item |> Result.mapError (\reason -> Index { at = index, inner = reason }))
                soFar
        )
        (Ok [])
        items


{-| A table, with every value read the same way. For a table whose keys are
data rather than structure.
-}
dict : Decoder a -> Decoder (Dict String a)
dict each_ =
    Decoder <| \content ->
        when content is
            Table.TableValue found ->
                Dict.foldl
                    (\name item soFar ->
                        Result.map2 (Dict.set name)
                            (run each_ item |> Result.mapError (\reason -> Field { name = name, inner = reason }))
                            soFar
                    )
                    (Ok Dict.empty)
                    (Table.entries found)

            _ ->
                Err (Expected { wanted = "a table", found = describe content })


{-| The table itself, undecoded, for walking by hand.
-}
table : Decoder Table
table =
    Decoder <| \content ->
        when content is
            Table.TableValue found ->
                Ok found

            _ ->
                Err (Expected { wanted = "a table", found = describe content })


{-| The value itself, undecoded.
-}
value : Decoder Table.Value
value =
    Decoder Ok


-- FIELDS


{-| The value under a key.
-}
field : String -> Decoder a -> Decoder a
field name inner =
    Decoder <| \content ->
        when content is
            Table.TableValue found ->
                when Table.get name found is
                    Just item ->
                        run inner item |> Result.mapError (\reason -> Field { name = name, inner = reason })

                    Nothing ->
                        Err (Field { name = name, inner = Custom "no such key" })

            _ ->
                Err (Expected { wanted = "a table", found = describe content })


{-| The value under a path of keys, which is what a `[a.b.c]` header wrote.

    Decode.at [ "servers", "alpha", "ip" ] Decode.string

-}
at : Array String -> Decoder a -> Decoder a
at path inner =
    Array.foldr field inner path


{-| The value under a key, or `Nothing` when there is no such key.

A key that *is* there but holds the wrong kind of value is still an error. Use
`maybe (field ...)` for the reading that forgives that too.

-}
optionalField : String -> Decoder a -> Decoder (Maybe a)
optionalField name inner =
    Decoder <| \content ->
        when content is
            Table.TableValue found ->
                when Table.get name found is
                    Just item ->
                        run inner item
                            |> Result.map Just
                            |> Result.mapError (\reason -> Field { name = name, inner = reason })

                    Nothing ->
                        Ok Nothing

            _ ->
                Err (Expected { wanted = "a table", found = describe content })


-- COMBINING


{-| A decoder that always produces this value and reads nothing.
-}
succeed : a -> Decoder a
succeed found =
    Decoder (\_ -> Ok found)


{-| A decoder that always fails with this message.
-}
fail : String -> Decoder a
fail message =
    Decoder (\_ -> Err (Custom message))


{-| Transform what a decoder produces.
-}
map : (a -> b) -> Decoder a -> Decoder b
map change (Decoder decode) =
    Decoder (\content -> Result.map change (decode content))


{-| Combine two decoders.
-}
map2 : (a -> b -> c) -> Decoder a -> Decoder b -> Decoder c
map2 combine first second =
    Decoder
        (\content ->
            Result.map2 combine (run first content) (run second content)
        )


{-| Combine three.
-}
map3 : (a -> b -> c -> d) -> Decoder a -> Decoder b -> Decoder c -> Decoder d
map3 combine first second third =
    map2 (\build value_ -> build value_) (map2 combine first second) third


{-| Combine any number, by pipeline.

    Decode.succeed Config
        |> Decode.andMap (Decode.field "host" Decode.string)
        |> Decode.andMap (Decode.field "port" Decode.int)
        |> Decode.andMap (Decode.field "debug" Decode.bool)

-}
andMap : Decoder a -> Decoder (a -> b) -> Decoder b
andMap argument build =
    map2 (\apply found -> apply found) build argument


{-| Decide what to read next from what was just read.
-}
andThen : (a -> Decoder b) -> Decoder a -> Decoder b
andThen next first =
    Decoder
        (\content ->
            run first content
                |> Result.andThen (\found -> run (next found) content)
        )


{-| The first decoder that succeeds.
-}
oneOf : Array (Decoder a) -> Decoder a
oneOf choices =
    Decoder
        (\content ->
            Array.foldl
                (\choice soFar ->
                    when soFar is
                        Ok found ->
                            Ok found

                        Err failures ->
                            when run choice content is
                                Ok found ->
                                    Ok found

                                Err reason ->
                                    Err (Array.pushLast reason failures)
                )
                (Err [])
                choices
                |> Result.mapError OneOfFailed
        )


{-| `Nothing` instead of an error.
-}
maybe : Decoder a -> Decoder (Maybe a)
maybe inner =
    Decoder
        (\content ->
            when run inner content is
                Ok found ->
                    Ok (Just found)

                Err _ ->
                    Ok Nothing
        )


{-| Defer building a decoder, for one that refers to itself.
-}
lazy : ({} -> Decoder a) -> Decoder a
lazy build =
    Decoder (\content -> run (build {}) content)


-- HELPERS


scalar : String -> (Table.Value -> Maybe a) -> Decoder a
scalar wanted read =
    Decoder
        (\content ->
            when read content is
                Just found ->
                    Ok found

                Nothing ->
                    Err (Expected { wanted = wanted, found = describe content })
        )


{-| What a value is, for an error message. Its kind, never its contents: a
message about a password should not contain the password.
-}
describe : Table.Value -> String
describe content =
    when content is
        Table.StringValue _ ->
            "a string"

        Table.IntegerValue _ ->
            "an integer"

        Table.FloatValue _ ->
            "a float"

        Table.BooleanValue _ ->
            "a boolean"

        Table.OffsetDateTimeValue _ ->
            "an offset date-time"

        Table.LocalDateTimeValue _ ->
            "a local date-time"

        Table.LocalDateValue _ ->
            "a local date"

        Table.LocalTimeValue _ ->
            "a local time"

        Table.ArrayValue _ ->
            "an array"

        Table.TableValue _ ->
            "a table"

        Table.TableArrayValue _ ->
            "an array of tables"
