module Toml.Literal exposing
    ( array
    , bigDecimal
    , bigInt
    , bool
    , float
    , inlineTable
    , int
    , key
    , literalString
    , localDate
    , localDateTime
    , localTime
    , multilineLiteralString
    , multilineString
    , offsetDateTime
    , path
    , simpleKey
    , string
    )

{-| Writing a value that was not read from a file.

Every node in the AST carries the text it was written as, which is what makes a
document that came from a file go back byte for byte. A value a program has just
made up has no such text yet, so something has to choose it, and this is where
that choosing is done -- once, so that `Toml.Edit` and `Toml.Encode` cannot
disagree about how to spell a float.

The choices are the plain ones: a bare key when the grammar allows and a quoted
one when it does not, decimal for integers, and only the escapes a string
actually needs.

Which of TOML's four string forms to write is a choice too, and it is the
caller's rather than this module's: [`string`](#string) is always `"..."`, and
the other three forms have a constructor each.

    Toml.Literal.string "10.0.0.1"      -- ip = "10.0.0.1"
    Toml.Literal.int 8000               -- ports = [8000]
    Toml.Literal.float 79.5             -- cpu = 79.5
    Toml.Literal.bool True              -- enabled = true

    Toml.Literal.array
        [ Toml.Literal.int 8000, Toml.Literal.int 8001, Toml.Literal.int 8002 ]
    -- ports = [8000, 8001, 8002]

    Toml.Literal.inlineTable
        [ { key = "cpu", value = Toml.Literal.float 79.5 }
        , { key = "case", value = Toml.Literal.float 72.0 }
        ]
    -- temp_targets = { cpu = 79.5, case = 72.0 }

The one to read twice is [`float`](#float), because a `Float` and a decimal are
not the same thing and this module has to pick one of them to write.

@docs string, multilineString, literalString, multilineLiteralString
@docs int, bigInt, float, bigDecimal, bool
@docs offsetDateTime, localDateTime, localDate, localTime
@docs array, inlineTable
@docs key, simpleKey, path

-}

import Array exposing (Array)
import Basics exposing (..)
import BigDecimal exposing (BigDecimal)
import BigInt exposing (BigInt)
import Civil.Date as Date exposing (Date)
import Civil.DateTime as DateTime exposing (DateTime)
import Civil.Time as CivilTime exposing (Time)
import Maybe exposing (Maybe(..))
import String
import Toml.Ast as Ast exposing (Key, SimpleKey, Value(..))
import Toml.Strings as Strings


-- KEYS


{-| The parts of a key, as the table tree names them.
-}
path : Key -> Array String
path name =
    Array.prepend [ name.first.value ] (Array.map (\part -> part.key.value) name.rest)


{-| A whole key from its parts.
-}
key : Array String -> Key
key parts =
    { first = simpleKey (Maybe.withDefault "" (Array.first parts))
    , rest =
        Array.dropFirst 1 parts
            |> Array.map
                (\name ->
                    { wsBefore = "", wsAfter = "", key = simpleKey name }
                )
    }


{-| One part of a key, written bare when the grammar allows and quoted when it
does not.
-}
simpleKey : String -> SimpleKey
simpleKey name =
    { raw =
        if Strings.isBareKey name then
            name

        else
            Strings.escape { multiline = False } name
    , value = name
    }


-- VALUES


{-| A string, written as a basic one: `"..."`, on one line, with `\n` for a
newline.

This is what a caller who has not thought about which form they want should
get, and it is what they have always got, so it does not change with the wind.
A string with newlines in it is better off as
[`multilineString`](#multilineString), but that is for the caller to say.

-}
string : String -> Value
string text =
    StringVal { raw = Strings.escape { multiline = False } text, value = text }


{-| A string, written as a multi-line basic one: `"""..."""`, opening with a
newline the reader trims, with the newlines and tabs in it written as
themselves.

Every string can be written this way -- the escapes are all still available
inside `"""` -- so this one never fails. It is the form for a value with lines
in it, which is to say a note, a key, a query, or anything else that a program
put in a config file for a person to read.

**A value that is already in the file is not re-spelled.**
[`Toml.Edit.set`](Toml-Edit#set) compares by meaning, and a basic string
already saying what this one says is left exactly as it was written. The form
is chosen when the key is written, not on every save.

-}
multilineString : String -> Value
multilineString text =
    StringVal { raw = Strings.escape { multiline = True } text, value = text }


{-| A string, written as a literal one: `'...'`, with no escapes at all.

`Nothing` when the string cannot be written that way, which is an apostrophe, a
newline, or a control character other than tab. A literal string has no escapes
-- that is the point of it, and it is why this cannot always be done.

It does not quietly write another form instead. A constructor whose output form
depended on its data would be one that changed the shape of a key between two
saves because somebody typed an apostrophe, and a noisy diff is the thing this
package is against. A caller who would
rather have a basic string than nothing can say so, and it reads as what it is:

    Maybe.withDefault (Toml.Literal.string text)
        (Toml.Literal.literalString text)

-}
literalString : String -> Maybe Value
literalString text =
    Strings.literal { multiline = False } text
        |> Maybe.map (\raw -> StringVal { raw = raw, value = text })


{-| A string, written as a multi-line literal one: `'''...'''`, with no escapes
and with the newlines in it written as themselves.

`Nothing` when the string cannot be written that way: a run of three
apostrophes, a run of them at the very end where the closing delimiter goes, a
lone carriage return, or a control character other than tab and newline. As
with [`literalString`](#literalString), no other form is written in its place.

-}
multilineLiteralString : String -> Maybe Value
multilineLiteralString text =
    Strings.literal { multiline = True } text
        |> Maybe.map (\raw -> StringVal { raw = raw, value = text })


{-| An integer that fits in a Gren `Int`.
-}
int : Int -> Value
int number =
    bigInt (BigInt.fromInt number)


{-| An integer of any size.
-}
bigInt : BigInt -> Value
bigInt number =
    IntegerVal { raw = BigInt.toString number, value = number }


{-| A float.

`inf` and `nan` are written as those words. Everything else is written as the
shortest decimal that reads back as the same `Float`, which is what
`String.fromFloat` gives: `3.14` and not the fifty-one digits of the binary
value that is nearest to it.

That is a choice, and it is the opposite of the one [`bigDecimal`](#bigDecimal)
makes. A `Float` *is* the nearest double, so the exact expansion is not wrong --
but it is not what the caller meant either, and writing it into a config file
would be a strange way to say `3.14`. A caller who does mean the exact value has
a `BigDecimal` and should say so.

Everything gets a decimal point even when it does not need one, because `1`
without one is an integer in TOML and this function was asked for a float.

-}
float : Float -> Value
float number =
    if Basics.isNaN number then
        FloatVal { raw = "nan", value = Ast.NotANumber Ast.Positive }

    else if Basics.isInfinite number then
        if number > 0 then
            FloatVal { raw = "inf", value = Ast.Infinite Ast.Positive }

        else
            FloatVal { raw = "-inf", value = Ast.Infinite Ast.Negative }

    else if number == 0 && 1 / number < 0 then
        -- `String.fromFloat` writes negative zero as `0`. The sign is the only
        -- thing there is to keep about it, so it is kept.
        FloatVal { raw = "-0.0", value = Ast.Finite BigDecimal.zero }

    else
        let
            written =
                String.fromFloat number
        in
        -- The raw text and the value have to say the same thing, so the value
        -- is read back out of the text rather than taken from the Float.
        when BigDecimal.fromString written is
            Just shortest ->
                FloatVal { raw = withPoint written, value = Ast.Finite shortest }

            Nothing ->
                -- Not reachable. `String.fromFloat` writes a finite double as
                -- digits with an optional sign, point and `e` exponent, and
                -- `BigDecimal.fromString` reads all of those. Writing `nan`
                -- here is the least wrong thing to do with a value that could
                -- not be spelled, and the Encoding suite checks the shapes
                -- `String.fromFloat` produces so a change to either would show.
                FloatVal { raw = "nan", value = Ast.NotANumber Ast.Positive }


{-| An exact decimal, written as it stands. Every digit of it, which is the
whole reason for having one -- see [`float`](#float) for the other choice.
-}
bigDecimal : BigDecimal -> Value
bigDecimal number =
    FloatVal
        { raw = withPoint (BigDecimal.toString number)
        , value = Ast.Finite number
        }


{-| A decimal point, if the text does not already have one or an exponent.
`1` is an integer in TOML and `1.0` is a float, so a float has to be spelled
like one however it was arrived at.
-}
withPoint : String -> String
withPoint written =
    if String.contains "." written || String.contains "e" written then
        written

    else
        written ++ ".0"


{-| A boolean.
-}
bool : Bool -> Value
bool flag =
    BooleanVal
        { raw =
            if flag then
                "true"

            else
                "false"
        , value = flag
        }


{-| A date and time with an offset. Fails over to a local date-time if the value
has no offset, since that is what it is.
-}
offsetDateTime : DateTime -> Value
offsetDateTime moment =
    if DateTime.isLocal moment then
        localDateTime moment

    else
        OffsetDateTimeVal { raw = DateTime.toString moment, value = moment }


{-| A date and time with no offset.
-}
localDateTime : DateTime -> Value
localDateTime moment =
    LocalDateTimeVal { raw = DateTime.toString moment, value = moment }


{-| A date.
-}
localDate : Date -> Value
localDate day =
    LocalDateVal { raw = Date.toString day, value = day }


{-| A time of day.
-}
localTime : Time -> Value
localTime clock =
    LocalTimeVal { raw = CivilTime.toString clock, value = clock }


-- THE ONE-LINE COMPOSITES


{-| An array on one line: `[1, 2, 3]`.

A space after each comma and none against the brackets, so an empty one is
`[]`. The elements are values, not fields, so an inline table inside an array
is [`inlineTable`](#inlineTable) -- there is no header to be had in there.

-}
array : Array Value -> Value
array items =
    ArrayVal
        { elements =
            Array.indexedMap
                (\index item ->
                    { before = spacing (index > 0)
                    , value = item
                    , after = []
                    , comma = index < Array.length items - 1
                    }
                )
                items
        , trailing = []
        }


{-| An inline table on one line: `{ a = 1, b = 2 }`.

A space inside each brace and one either side of every equals sign, except that
an empty one is `{}` -- a space inside that would be an odd thing to write.

-}
inlineTable : Array { key : String, value : Value } -> Value
inlineTable fields =
    InlineTableVal
        { entries =
            Array.indexedMap
                (\index it ->
                    { before = spacing True
                    , keyval =
                        { key = key [ it.key ]
                        , wsBeforeEq = " "
                        , wsAfterEq = " "
                        , value = it.value
                        }
                    , after = []
                    , comma = index < Array.length fields - 1
                    }
                )
                fields
        , trailing = spacing (Array.length fields > 0)
        }


spacing : Bool -> Ast.Trivia
spacing wanted =
    if wanted then
        [ Ast.Spaces " " ]

    else
        []
